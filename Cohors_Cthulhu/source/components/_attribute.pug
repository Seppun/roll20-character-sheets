//- components/_attribute.pug
//- One column of the Attributes table: a Rating input, and (for the three
//- attributes the rulebook grants it to - Brawn, Insight, Will) a Bonus
//- Damage field. Autocalc for bonus damage lands in a later stage.
mixin attribute(name, hasBonusDamage)
  .cc-attribute
    span.cc-attribute-label(data-i18n=name)= name
    +number({name: `${name} rating`}).cc-attribute-rating
    if hasBonusDamage
      +number({name: `${name} bonus damage`, readonly: true}).cc-attribute-bonus-damage
    else
      span.cc-attribute-bonus-damage.cc-disabled
