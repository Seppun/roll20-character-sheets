//- views/_notes.pug
//- Page 4 of the official sheet (Traits, History, Personal Agenda,
//- Journal/Notes) plus Belongings from page 2, merged here since Combat
//- otherwise held very little on its own. Talents moved to the Character
//- tab (views/panels/_talents_panel.pug) since it's referenced often
//- enough during play to warrant living on page 1.
+tab({name: 'notes', container: 'article', button: {content: 'Notes'}})
  .cc-page.cc-notes

    .cc-field-group
      .cc-panel.cc-traits
        .cc-banner Traits
        +textarea({name: 'traits'})
      .cc-panel.cc-history-agenda
        .cc-banner History
        +textarea({name: 'history'})
        .cc-banner Personal Agenda
        +textarea({name: 'personal agenda'})

    .cc-panel.cc-belongings
      .cc-banner Belongings
      +textarea({name: 'belongings'})

    .cc-panel.cc-journal
      .cc-banner Journal/Notes
      +textarea({name: 'journal notes'})

+scss.
  .cc-notes {
    .cc-field-group {
      align-items: stretch;
    }

    .cc-traits,
    .cc-history-agenda {
      flex: 1 1 45%;
    }

    textarea {
      width: 100%;
      min-height: 6rem;
      // Belongings originally had the only bordered textarea on this
      // page (an actual box, rather than k-scaffold's plain default
      // underline) at full strength (--cc-rule) - every field here now
      // gets the same box, fainter (--cc-rule-soft, the same softened
      // tone used for repeating-row dividers), Belongings included, for a
      // consistent look across the whole page. background matches the
      // same light editable-field fill as .cc-field's own :read-write
      // inputs (scss/_index.scss) - these textareas aren't wrapped in a
      // .cc-field so they don't inherit that rule automatically.
      background: var(--cc-editable-fill);
      border: 1px solid var(--cc-rule-soft);
      color: var(--cc-ink);
    }

    .cc-journal textarea {
      min-height: 14rem;
    }
  }
