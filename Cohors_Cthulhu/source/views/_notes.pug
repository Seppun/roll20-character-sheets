//- views/_notes.pug
//- Page 4 of the official sheet (Traits, History, Personal Agenda,
//- Journal/Notes) plus Belongings and Talents from page 2, merged here
//- since Combat otherwise held very little on its own.
+tab({name: 'notes', container: 'article', button: {content: 'Notes'}})
  .cc-page.cc-notes

    .cc-field-group
      .cc-panel.cc-traits
        .cc-banner Traits
        +textarea({name: 'traits'})
      .cc-panel.cc-history-agenda
        .cc-banner History
        +textarea({name: 'history'})
        .cc-banner Personal Agenda
        +textarea({name: 'personal agenda'})

    .cc-panel.cc-belongings
      .cc-banner Belongings
      +textarea({name: 'belongings'})

    .cc-panel.cc-talents
      .cc-banner Talents
      .cc-rep-table.cc-rep-talents
        .cc-rep-header
          span Name
          span Keywords
          span Description
        +fieldset({name: 'talent'})
          +text({name: 'name'})
          +text({name: 'keywords'})
          +textarea({name: 'description'})

    .cc-panel.cc-journal
      .cc-banner Journal/Notes
      +textarea({name: 'journal notes'})

+scss.
  .cc-notes {
    .cc-field-group {
      align-items: stretch;
    }

    .cc-traits,
    .cc-history-agenda {
      flex: 1 1 45%;
    }

    textarea {
      width: 100%;
      min-height: 6rem;
    }

    .cc-journal textarea {
      min-height: 14rem;
    }

    .cc-rep-talents {
      .cc-rep-header,
      fieldset,
      .repcontainer .repitem {
        grid-template-columns: 1fr 1fr 3fr;
      }

      textarea {
        min-height: 3rem;
      }
    }

    .cc-belongings textarea {
      min-height: 6rem;
      width: 100%;
      background: transparent;
      border: 1px solid var(--cc-rule);
      color: var(--cc-ink);
    }
  }
