//- views/_spells.pug
//- Page 3 of the official sheet: spellcasting header + spell list.
//- The printed sheet has 6 fixed spell blocks; built as a repeating
//- section here instead so casters aren't capped at 6.
- const ccSpellbooks = require('./source/data/spells.json');
+tab({name: 'spells', container: 'article', button: {content: 'Spells'}})
  .cc-page.cc-spells

    .cc-panel.cc-spellcasting-header
      .cc-banner Spellcasting
      .cc-field-group
        .cc-field
          span Spellcasting Type
          +select({
            name: 'spellcasting type',
            trigger: {affects: ['spellcasting_attribute', 'base_power', 'power_rating']}
          })
            +option({value: ''})
              | Select One
            +option({value: 'traditional'})
              | Traditional
            +option({value: 'research'})
              | Research
            +option({value: 'dabbling'})
              | Dabbling
        .cc-field
          span Magical Tradition
          //- A fixed choice, not free text: the Spell Name dropdown below
          //- filters its suggestions to this tradition's spellbook, which
          //- only works if this value is one of a known, fixed set.
          +select({
            name: 'magical tradition',
            trigger: {affects: ['tradition_marker']}
          })
            +option({value: ''})
              | Select One
            +option({value: 'runic'})
              | Runic
            +option({value: 'oracular'})
              | Oracular
            +option({value: 'celtic'})
              | Celtic
        .cc-field
          //- Not a free choice: Traditional casters use Insight, Research
          //- casters use Reason, Dabblers use Will - fixed by RAW, so this
          //- is derived from Spellcasting Type rather than user-selected.
          span Spellcasting Attribute
          +text({
            name: 'spellcasting attribute',
            readonly: true,
            trigger: {calculation: 'calcSpellcastingAttribute', affects: ['power_rating']}
          })
        .cc-field
          span Power Rating
          +number({name: 'power rating', readonly: true, trigger: {calculation: 'calcPowerRating'}})
        .cc-field
          span Base Power
          +number({name: 'base power', readonly: true, trigger: {calculation: 'calcBasePower', affects: ['power_rating']}})

    //- Hidden radio group mirroring Magical Tradition, following the same
    //- "hidden radio + CSS general sibling selector" trick used for the
    //- Stress Max marker on the Character tab: pure CSS can't compare the
    //- Magical Tradition select's value against anything, but it CAN match
    //- on a hidden radio's :checked state. These three radios must be
    //- direct siblings of .cc-spell-list (NOT wrapped in their own div) -
    //- the `~` general sibling combinator below only matches elements that
    //- share the same parent, and both live directly under .cc-page.cc-spells.
    +radio({
      name: 'tradition marker',
      value: 'runic',
      trigger: {calculation: 'calcTraditionMarker'}
    }).cc-tradition-marker-runic
    +radio({
      name: 'tradition marker',
      value: 'oracular',
      trigger: {calculation: 'calcTraditionMarker'}
    }).cc-tradition-marker-oracular
    +radio({
      name: 'tradition marker',
      value: 'celtic',
      trigger: {calculation: 'calcTraditionMarker'}
    }).cc-tradition-marker-celtic

    .cc-panel.cc-spell-list
      .cc-banner Spells
      +fieldset({name: 'spell'})
        .cc-spell-block
          .cc-field-group
            .cc-field
              span Name
              //- Three variants of the same underlying "name" attribute -
              //- one plain <select> per magical tradition, each hardcoded
              //- with only that tradition's spells (the list is short
              //- enough that, unlike Talents, a real dropdown beats a
              //- free-typed combobox - matches how Weapons/Armor work).
              //- Only one is ever visible at a time (CSS below, driven by
              //- the hidden tradition marker), but since all three share
              //- the same attribute name, they stay in sync automatically.
              //- A <select>'s own change event fires immediately (unlike
              //- the old <datalist> input this replaced), so no separate
              //- apply button is needed.
              //-
              //- Options are written out individually rather than looped
              //- from ccSpellbooks, matching the same workaround already
              //- used for the Weapons/Armor dropdowns - see the comment
              //- above ccWeaponProfiles for why an `each` loop over
              //- +option() silently breaks (a k-scaffold mixin bug).
              .cc-spell-name-row
                +action({
                  name: 'spell cast',
                  class: 'cc-spell-cast roller',
                  trigger: {triggeredFuncs: ['initiateSpellRoll']}
                })
                +select({
                  name: 'name',
                  trigger: {triggeredFuncs: ['ccApplySpellPreset']}
                }).cc-spell-name-runic
                  +option({value: ''})
                    | Select Spell
                  +option({value: 'Blessing of Fylgjur'})
                    | Blessing of Fylgjur
                  +option({value: 'Bounty of Baldr'})
                    | Bounty of Baldr
                  +option({value: 'Curse of Loki'})
                    | Curse of Loki
                  +option({value: 'Hammer of Thunraz'})
                    | Hammer of Thunraz
                  +option({value: 'Ravens of Wodan'})
                    | Ravens of Wodan
                  +option({value: 'Swiftness of Sleipnir'})
                    | Swiftness of Sleipnir
                  +option({value: 'Wisdom of Frigg'})
                    | Wisdom of Frigg
                +select({
                  name: 'name',
                  trigger: {triggeredFuncs: ['ccApplySpellPreset']}
                }).cc-spell-name-oracular
                  +option({value: ''})
                    | Select Spell
                  +option({value: 'Augury'})
                    | Augury
                  +option({value: 'Guiding Hand'})
                    | Guiding Hand
                  +option({value: 'Invoke the Parcae'})
                    | Invoke the Parcae
                  +option({value: 'Prescience'})
                    | Prescience
                  +option({value: 'Scrying'})
                    | Scrying
                  +option({value: 'Second Sight'})
                    | Second Sight
                +select({
                  name: 'name',
                  trigger: {triggeredFuncs: ['ccApplySpellPreset']}
                }).cc-spell-name-celtic
                  +option({value: ''})
                    | Select Spell
                  +option({value: 'Bounties of the Dagda'})
                    | Bounties of the Dagda
                  +option({value: 'Cyclone of Cernunnos'})
                    | Cyclone of Cernunnos
                  +option({value: 'Gaze of Balor'})
                    | Gaze of Balor
                  +option({value: 'Gift of Arduinna'})
                    | Gift of Arduinna
                  +option({value: 'Horn of Néit'})
                    | Horn of Néit
                  +option({value: 'Roots of the Earth'})
                    | Roots of the Earth
                  +option({value: 'Spear of Lug'})
                    | Spear of Lug
                  +option({value: 'The Ogham Sign'})
                    | The Ogham Sign
            .cc-field
              span Skill
              +text({name: 'skill'})
            .cc-field
              span Difficulty
              //- Free text, not a number: some spells (e.g. Gaze of Balor)
              //- specify an opposed test - "2, opposed by target's Will +
              //- Resilience" - rather than a bare difficulty number.
              +text({name: 'difficulty'})
            .cc-field
              span Cost
              +text({name: 'cost'})
            .cc-field
              span Duration
              +text({name: 'duration'})
            .cc-field
              span Category
              +text({name: 'category'})
          //- Effect/Momentum are the two longest fields in each block, so
          //- they're collapsible behind a small eagle toggle - a plain
          //- hidden checkbox styled to look like the toggle itself (rather
          //- than a separate <label>), using the same "hidden input + CSS
          //- general sibling selector" trick as the Stress Max marker and
          //- the tradition marker above: the checkbox and the content div
          //- are true siblings, so :checked can show/hide the content with
          //- no sheet-worker/JS involvement. Unique per row since this is
          //- inside the repeating section, so each spell's card collapses
          //- independently.
          +checkbox({name: 'effect collapsed', value: 1}).cc-spell-collapse-toggle
          .cc-spell-collapse-content
            .cc-field
              span Spell Effect
              +textarea({name: 'effect'}).cc-spell-textarea
            .cc-field
              span Momentum
              +textarea({name: 'momentum'}).cc-spell-textarea

+scss.
  .cc-spells {
    .cc-spell-block {
      border: 1px solid var(--cc-rule);
      border-radius: 3px;
      padding: 0.5rem;
      margin-bottom: 0.5rem;

      textarea {
        min-height: 3rem;
        width: 100%;
      }
    }

    // The hidden tradition-marker radios (see the pug comment above them,
    // near the Magical Tradition select) never need to be visible
    // themselves - only their checked state matters, which display:none
    // doesn't affect.
    .cc-tradition-marker-runic,
    .cc-tradition-marker-oracular,
    .cc-tradition-marker-celtic {
      display: none;
    }

    // Hide all three Name-input variants by default; the rules below then
    // reveal only the one matching the checked tradition marker. Until a
    // Magical Tradition is chosen, none of the markers are checked and the
    // Name field for every spell row stays hidden.
    .cc-spell-name-runic,
    .cc-spell-name-oracular,
    .cc-spell-name-celtic {
      display: none;
    }

    .cc-tradition-marker-runic:checked ~ .cc-spell-list .cc-spell-name-runic {
      display: block;
    }

    .cc-tradition-marker-oracular:checked ~ .cc-spell-list .cc-spell-name-oracular {
      display: block;
    }

    .cc-tradition-marker-celtic:checked ~ .cc-spell-list .cc-spell-name-celtic {
      display: block;
    }

    .cc-spell-name-row {
      display: flex;
      align-items: center;
      gap: 0.3rem;

      select {
        flex: 1 1 auto;
      }
    }

    .cc-spell-cast {
      background: none;
      border: none;
      padding: 0;
      color: inherit;
      font-size: 1.1rem;
      cursor: pointer;

      &:before {
        opacity: 0.8;
      }

      &:hover:before {
        opacity: 1;
      }
    }

    // Fold/unfold toggle for the Effect/Momentum content below it - a
    // native checkbox with its default appearance stripped and a glyph
    // drawn via :before instead, so no separate <label> is needed (the
    // checkbox itself stays natively clickable). Unchecked (the default) =
    // expanded; checked = collapsed, with the glyph rotating 180deg to
    // show which way it's currently "folded".
    //
    // This was originally an eagle emoji (matching the sheet's Roman/SPQR
    // theme), but that's an astral-plane character (outside the Basic
    // Multilingual Plane) - Sass compiles a \1F985 escape straight into
    // the literal 4-byte UTF-8 character in the output CSS, and Roll20's
    // savesheetsettings endpoint 500s on custom sheet code containing one
    // (confirmed: a fresh game with this pasted in came back blank with a
    // 500 on save; reverting to the commit before this glyph existed
    // worked fine). A plain triangle is BMP-safe and reads the same way.
    .cc-spell-collapse-toggle {
      appearance: none;
      -webkit-appearance: none;
      background: none;
      border: none;
      width: auto;
      height: auto;
      margin: 0 0 0.2rem;
      padding: 0;
      cursor: pointer;
      font-size: 1rem;
      line-height: 1;

      &:before {
        content: '\25BE';
        display: inline-block;
        opacity: 0.8;
        transition: transform 150ms ease;
      }

      &:hover:before {
        opacity: 1;
      }

      &:checked:before {
        transform: rotate(180deg);
      }
    }

    .cc-spell-collapse-toggle:checked ~ .cc-spell-collapse-content {
      display: none;
    }

    .cc-spell-textarea {
      font-size: 12px;
    }
  }

+module.
  // Traditional casters use Insight, Research casters use Reason,
  // Dabblers use Will - fixed by spellcasting type, not a free choice.
  const calcSpellcastingAttribute = ({attributes}) => {
    const type = attributes.spellcasting_type;
    if (type === 'traditional') { return 'Insight'; }
    if (type === 'research') { return 'Reason'; }
    if (type === 'dabbling') { return 'Will'; }
    return '';
  };
  k.registerFuncs({calcSpellcastingAttribute});

  // Base Power: 2 for Traditional/Research, 1 for Dabbling.
  const calcBasePower = ({attributes}) => {
    const type = attributes.spellcasting_type;
    if (type === 'dabbling') { return 1; }
    if (type === 'traditional' || type === 'research') { return 2; }
    return 0;
  };
  k.registerFuncs({calcBasePower});

  // Power Rating = Base Power + ccAttributeBonus(casting attribute rating).
  // ccAttributeBonus is defined in views/_character.pug's +module block -
  // both end up in the same sheet-worker script scope.
  const calcPowerRating = ({attributes}) => {
    const base = Number(attributes.base_power) || 0;
    const attr = (attributes.spellcasting_attribute || '').toLowerCase();
    const rating = attr ? attributes[`${attr}_rating`] : 0;
    return base + ccAttributeBonus(rating);
  };
  k.registerFuncs({calcPowerRating});

  // Keeps the hidden tradition-marker radio group (see the pug comment
  // above .cc-spell-tradition-marker) in sync with Magical Tradition.
  const calcTraditionMarker = ({attributes}) => attributes.magical_tradition;
  k.registerFuncs({calcTraditionMarker});

  // Spell data keyed by tradition then spell name - see source/data/spells.json.
  const ccSpellbooks = !{JSON.stringify(ccSpellbooks)};
  const ccApplySpellPreset = ({trigger, attributes}) => {
    const [section, rowID] = k.parseRepeatName(trigger.name);
    const prefix = `${section}_${rowID}_`;
    const tradition = attributes.magical_tradition;
    const book = tradition && ccSpellbooks[tradition];
    const profile = book && book[attributes[`${prefix}name`]];
    if (!profile) { return; }
    Object.keys(profile).forEach((field) => {
      attributes[`${prefix}${field}`] = profile[field];
    });
  };
  k.registerFuncs({ccApplySpellPreset});

  // A spell's Difficulty is free text (see the pug comment above that
  // field) so an opposed-test qualifier like "2, opposed by target's Will
  // + Resilience" can be stored alongside the number - this pulls out just
  // the leading number for the actual skill test.
  const ccParseLeadingNumber = (text) => {
    const match = String(text || '').match(/\d+/);
    return match ? Number(match[0]) : 0;
  };

  // Spell Cost fields read like "4 Drain" or "5 Drain, Piercing 1" - a
  // Challenge Dice count glued to its first damage effect, then any
  // further effects comma-separated (see source/data/spells.json). Mirrors
  // ccParseDamageEffects above for Weapons, but the count and its effect
  // share one comma segment here instead of being their own segments.
  //
  // "Drain" is filtered out of the returned effects: every spell's Cost is
  // Drain (that's just naming the damage as mental/Drain-type, per the
  // rulebook's Spell Format section), so it always applies and isn't a
  // bonus effect that should only show up when an Effect face is rolled -
  // unlike a genuine extra like Piercing or Stun.
  const ccParseSpellCost = (text) => {
    const segments = String(text || '').split(',').map((s) => s.trim()).filter(Boolean);
    const [first, ...rest] = segments;
    const match = (first || '').match(/^(\d+)\s*(.*)$/);
    const diceCount = match ? Number(match[1]) : 0;
    const firstEffect = match && match[2] ? match[2].trim() : '';
    return {
      diceCount,
      effects: [firstEffect, ...rest].filter((e) => e && !/^drain\b/i.test(e)),
    };
  };

  // Spells whose own Momentum options let the caster pay Momentum to scale
  // up an effect AND explicitly say that scaling also lands on the Cost
  // roll - currently just Scrying ("Unlike the costs of most spells,
  // Scrying's cost increases by +1 Challenge Die for each Momentum spent
  // on either of the following options"). Every other spell with a
  // Momentum-scaled effect (Cyclone of Cernunnos's own damage, Horn of
  // Néit's own Challenge Die, etc.) scales something this sheet doesn't
  // otherwise roll, so Extra Momentum is still tracked and shown for them
  // (see initiateSpellRoll below), it just doesn't add to Cost dice.
  // Kept separate from spells.json/ccSpellbooks (rather than a key on
  // each spell profile) so ccApplySpellPreset's generic copy loop doesn't
  // also write it into a meaningless row attribute.
  const ccSpellMomentumCostDice = {
    'Scrying': 1,
  };

  // Casting roll: a standard 2d20 skill test (Spellcasting Attribute + the
  // spell's own Skill, vs its Difficulty), with the spell's Cost rolled
  // alongside it in the same message - like a Weapon's attack+damage, but
  // gated on nothing, since RAW says the cost "applies after the
  // spellcaster resolves the skill test... whether or not they
  // successfully cast it" (see Casting a Battlefield Spell, page 66).
  // ccChallengeDieFromD6 is defined in views/_character.pug's +module
  // block - both end up in the same sheet-worker script scope.
  const initiateSpellRoll = async ({trigger, attributes}) => {
    const [section, rowID] = k.parseRepeatName(trigger.name);
    const prefix = `${section}_${rowID}_`;
    const spellName = attributes[`${prefix}name`] || 'Spell';
    const skillName = attributes[`${prefix}skill`] || '';
    const skillSlug = skillName.toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
    const skillRanks = Number(attributes[`${skillSlug}_ranks`]) || 0;

    const castAttr = (attributes.spellcasting_attribute || '').toLowerCase();
    const attributeRating = Number(attributes[`${castAttr}_rating`]) || 0;

    const difficultyDefault = ccParseLeadingNumber(attributes[`${prefix}difficulty`]) || 1;
    const {diceCount: costDiceCount, effects: costEffects} = ccParseSpellCost(attributes[`${prefix}cost`]);
    const costDicePerMomentum = ccSpellMomentumCostDice[spellName] || 0;

    const difficultyQuery = `?{Difficulty|${difficultyDefault}}`;
    const complicationQuery = '?{Complication range (1-5)|1}';
    const bonusDiceQuery = '?{Additional d20s bought (0-3)|0}';
    // Reused verbatim (identical query text) in both extra_momentum and
    // cost_dice below - Roll20 only prompts once per unique query per
    // roll and substitutes that same answer everywhere it appears, the
    // same way bonusDiceQuery above is embedded directly into roll1's
    // dice count rather than resolved separately.
    const extraMomentumQuery = '?{Extra Momentum spent|0}';

    const rollString = '&{template:ccskill} ' +
      `{{character_name=@{character_name}}} ` +
      `{{skill=${spellName}}} ` +
      (skillName ? `{{focus=${skillName}}} ` : '') +
      `{{attribute_choice=[[0+${attributeRating}]]}} ` +
      `{{difficulty=[[0+${difficultyQuery}]]}} ` +
      `{{complication_range=[[0+${complicationQuery}]]}} ` +
      `{{roll1=[[(2+${bonusDiceQuery})d20]]}} ` +
      `{{extra_momentum=[[0+${extraMomentumQuery}]]}} ` +
      `{{target_number=[[0]]}} ` +
      `{{successes=[[0]]}} ` +
      `{{dice_text=[[0]]}} ` +
      `{{outcome=[[0]]}} ` +
      `{{complications=[[0]]}} ` +
      `{{bonus_momentum=[[0]]}} ` +
      `{{momentum_spent=[[0]]}} ` +
      `{{is_spell=1}} ` +
      `{{cost_dice=[[(${Math.max(0, costDiceCount)}+(${extraMomentumQuery})*${costDicePerMomentum})d6]]}} ` +
      `{{cost_total=[[0]]}} ` +
      `{{cost_effect_count=[[0]]}} ` +
      `{{cost_dice_text=[[0]]}} ` +
      `{{cost_effects_summary=[[0]]}}`;

    const roll = await startRoll(rollString);

    try {
      const difficulty = Number(roll.results.difficulty.result) || 1;
      const complicationRange = Number(roll.results.complication_range.result) || 1;
      const extraMomentum = Number(roll.results.extra_momentum.result) || 0;

      const roll1 = roll.results.roll1;
      const dice = Array.isArray(roll1.dice) ?
        roll1.dice :
        (roll1.rolls && roll1.rolls[0] && roll1.rolls[0].results || []).map((r) => r.v);

      // Crit only on a natural 1, per RAW - spellcasting has no Focus
      // mechanic to widen that range the way a known Weapon Focus can.
      const targetNumber = attributeRating + skillRanks;
      const complicationThreshold = 21 - complicationRange;
      const successCount = dice.filter((d) => d <= targetNumber).length +
        dice.filter((d) => d <= 1).length;
      const complicationCount = dice.filter((d) => d >= complicationThreshold).length;
      const passed = successCount >= difficulty;

      const costDiceRoll = roll.results.cost_dice;
      const rawCostDice = Array.isArray(costDiceRoll.dice) ?
        costDiceRoll.dice :
        (costDiceRoll.rolls && costDiceRoll.rolls[0] && costDiceRoll.rolls[0].results || []).map((r) => r.v);

      const converted = rawCostDice.map(ccChallengeDieFromD6);
      const isVicious = costEffects.some((e) => /vicious/i.test(e));
      const effectCount = converted.filter((c) => c.effect).length;
      const totalCost = converted.reduce((sum, c) => sum + c.pips, 0) +
        (isVicious ? effectCount : 0);
      const effectsSummary = effectCount > 0 ?
        `${effectCount}x Effect${costEffects.length ? ` - ${costEffects.join(', ')}` : ''}` :
        'No Effects triggered';

      const spellBonusMomentum = passed ? Math.max(0, successCount - difficulty) : 0;
      const spellBonusDiceBought = Math.max(0, dice.length - 2);
      // ccSendMomentumSignal is defined in views/_character.pug's +module
      // block - both end up in the same sheet-worker script scope.
      await ccSendMomentumSignal(spellBonusMomentum - spellBonusDiceBought - extraMomentum);

      finishRoll(roll.rollId, {
        target_number: targetNumber,
        successes: successCount,
        dice_text: dice.join(', '),
        outcome: passed ? 1 : 0,
        bonus_momentum: spellBonusMomentum,
        complications: complicationCount,
        extra_momentum: extraMomentum,
        momentum_spent: spellBonusDiceBought + extraMomentum,
        cost_total: totalCost,
        cost_effect_count: effectCount,
        cost_dice_text: converted.map((c) => c.symbol).join(' '),
        cost_effects_summary: effectsSummary,
      });
    } catch (err) {
      finishRoll(roll.rollId, {
        target_number: '?',
        successes: '?',
        dice_text: `error: ${err.message}`,
        outcome: 0,
        complications: 0,
        cost_total: '?',
        cost_effect_count: '?',
        cost_dice_text: `error: ${err.message}`,
        cost_effects_summary: '',
      });
    }
  };
  k.registerFuncs({initiateSpellRoll});
