      // fleck pattern (fewer, slightly bigger dots than .cc-focus-roll's
      // pill, since the chip itself is much smaller).
      .cc-weapon-roll {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.4rem;
        height: 1.4rem;
        background-image:
          radial-gradient(circle at 61% 17%, rgba(74, 53, 30, 0.6) 0%, transparent 6%),
          radial-gradient(circle at 27% 68%, rgba(92, 74, 48, 0.5) 0%, transparent 4%),
          radial-gradient(circle at 83% 19%, rgba(92, 74, 48, 0.5) 0%, transparent 3%),
          radial-gradient(circle at 11% 29%, rgba(92, 74, 48, 0.5) 0%, transparent 3%),
          radial-gradient(circle at 7% 25%, rgba(109, 80, 52, 0.55) 0%, transparent 2%),
          radial-gradient(circle at 54% 27%, rgba(109, 80, 52, 0.55) 0%, transparent 2%),
          radial-gradient(circle at 78% 9%, rgba(109, 80, 52, 0.55) 0%, transparent 2%),
          radial-gradient(circle at 68% 37%, rgba(109, 80, 52, 0.55) 0%, transparent 1%),
          linear-gradient(145deg, var(--cc-stone-light) 0%, var(--cc-stone-dark) 100%);
        background-repeat: no-repeat;
        background-size: 100% 100%;
        border: 1px solid var(--cc-stone-bezel);
        border-radius: 4px;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.45),
