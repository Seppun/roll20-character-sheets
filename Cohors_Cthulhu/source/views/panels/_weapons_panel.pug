    +fieldset({name: 'weapon'})
      //- Triggers a Fighting roll using this row's Focus, plus a
      //- damage roll from its Damage & Effects, together in a single
      //- message (see initiateWeaponRoll).
      +action({
        name: 'weapon roll',
        class: 'cc-weapon-roll roller',
        trigger: {triggeredFuncs: ['initiateWeaponRoll']}
      })
      //- Options are written out individually rather than generated
