//- views/panels/_skills_panel.pug
//- Skills table (+skill mixin, source/components/_skill.pug) with their
//- Focuses. Resilience's own +skill() call reaches into Vitals' Max
//- Stress attributes via its extraAffects argument - no cross-file JS
//- coupling, see the comment at the top of
//- views/panels/_vitals_panel.pug/_attributes_panel.pug for why that's
//- fine.
.cc-panel.cc-skills
  .cc-banner Skills
  table.cc-table.cc-skills-table
    thead
      tr
        th Skill
        th Ranks
        th Focuses
    tbody
      +skill('academia', ['Finance', 'History', 'Linguistics', 'Philosophy', 'Religion'])
      +skill('athletics', ['Climbing', 'Lifting', 'Physical Training', 'Running', 'Swimming'])
      +skill('crafting', ['Armorsmithing', 'Cooking', 'Tailoring', 'Weaponsmithing'])
      +skill('engineering', ['Architecture', 'Defenses', 'Demolition', 'Infrastructure', 'Siege Engines'])
      +skill('fighting', ['Archery', 'Melee Weapons', 'Thrown Weapons', 'Unarmed', 'War Magic'])
      +skill('medicine', ['Contagion', 'Faith Healing', 'Field Treatment', 'Pharmacia', 'Surgery'])
      +skill('observation', ['Hearing', 'Instincts', 'Sight', 'Smell and Taste'])
      +skill('persuasion', ['Charm', 'Deception', 'Innuendo', 'Intimidation', 'Invocation', 'Negotiation', 'Rhetoric'])
      +skill('resilience', ['Discipline', 'Fortitude', 'Immunity'], ['stress_max_base', 'stress_max', 'stress_max_marker', 'fatigue_max_marker'])
      +skill('stealth', ['Concealment', 'Disguise', 'Escape Artistry', 'Lock Picking', 'Sleight of Hand', 'Sneak'])
      +skill('survival', ['Animal Handling', 'Boating', 'Foraging', 'Hunting', 'Mysticism', 'Navigation', 'Tracking', 'Woodcraft'])
      +skill('tactics', ['Cavalry', 'Infantry', 'Leadership', 'Navy', 'Omen Reading', 'Scouting'])

+scss.
  .cc-character {
    .cc-skills-table {
      th,
      td {
        vertical-align: middle;
        min-height: 2.6rem;
      }

      // No row-divider under the Ranks column - only the Skill/Focuses
      // columns carry the row-separator line.
      td.cc-skill-ranks-cell {
        border-bottom: none;
      }

      // Same "make it read as a button, enlarge the die icon" treatment as
      // .cc-attribute-roll (views/panels/_attributes_panel.pug) - see its
      // comment for why. A fixed width (rather than sizing to each skill
      // name's own text, which made every button a different width -
      // "Stealth" vs "Engineering") keeps the whole column uniform; sized
      // to fit the longest name (Engineering/Observation, 11 characters)
      // with room to spare.
      .cc-skill-name-roll {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        gap: 0.3rem;
        width: 8.5rem;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid var(--cc-banner-text);
        border-radius: 4px;
        padding: 0.15rem 0.5rem;
        color: inherit;
        font: inherit;
        text-transform: inherit;
        letter-spacing: inherit;
        white-space: nowrap;
        cursor: pointer;

        &:hover {
          background: var(--cc-banner-text);
          color: var(--cc-banner);
        }

        &:before {
          content: '0';
          font-size: 1.5em;
          opacity: 1;
        }
      }

      // Always player-entered - no calculated/readonly counterpart exists
      // in this table, unlike Attributes' Rating/Bonus Damage pair.
      .cc-skill-ranks {
        width: 3rem;
        text-align: center;
        background: var(--cc-editable-fill);
        border: 1px solid var(--cc-rule);
        color: var(--cc-ink);
      }

      td.cc-skill-focuses {
        display: flex;
        flex-wrap: wrap;
        align-content: center;
        align-items: center;
        gap: 0.15rem 0.6rem;
      }
    }

    .cc-focus-item {
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
      font-size: 0.8rem;
      white-space: nowrap;

      // k-scaffold's default checkbox border never applies (see
      // lessons_learned.md) - set explicitly here instead.
      .cc-focus-checkbox {
        margin: 0;
        width: 0.8rem !important;
        height: 0.8rem !important;
        min-width: 0.8rem !important;
        min-height: 0.8rem !important;
        border: 1px solid var(--cc-rule) !important;
        background: var(--cc-parchment) !important;
      }

      // Carved-stone-block look (see --cc-stone-* in scss/_variables.scss)
      // - a compact pill rather than .cc-skill-name-roll's bigger one,
      // since many of these wrap per skill row and need to stay small.
      // The small dark flecks are plain radial-gradient dots (no image
      // file or data: URI - see lessons_learned.md for why that matters
      // on this sheet) standing in for travertine's actual pitted pores.
      // The border/box-shadow pair is thin and single-layer so the bevel
      // reads as worn stone rather than a thick picture frame.
      .cc-focus-roll {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        background-image:
          radial-gradient(circle at 41% 31%, rgba(74, 53, 30, 0.6) 0%, transparent 5%),
          radial-gradient(circle at 85% 56%, rgba(92, 74, 48, 0.5) 0%, transparent 4%),
          radial-gradient(circle at 54% 41%, rgba(92, 74, 48, 0.5) 0%, transparent 4%),
          radial-gradient(circle at 56% 71%, rgba(92, 74, 48, 0.5) 0%, transparent 3%),
          radial-gradient(circle at 79% 45%, rgba(92, 74, 48, 0.5) 0%, transparent 3%),
          radial-gradient(circle at 21% 67%, rgba(92, 74, 48, 0.5) 0%, transparent 3%),
          radial-gradient(circle at 63% 59%, rgba(92, 74, 48, 0.5) 0%, transparent 3%),
          radial-gradient(circle at 76% 11%, rgba(109, 80, 52, 0.55) 0%, transparent 2%),
          radial-gradient(circle at 81% 26%, rgba(109, 80, 52, 0.55) 0%, transparent 2%),
          radial-gradient(circle at 71% 19%, rgba(109, 80, 52, 0.55) 0%, transparent 2%),
          radial-gradient(circle at 16% 85%, rgba(109, 80, 52, 0.55) 0%, transparent 2%),
          radial-gradient(circle at 93% 12%, rgba(109, 80, 52, 0.55) 0%, transparent 1%),
          radial-gradient(circle at 61% 59%, rgba(109, 80, 52, 0.55) 0%, transparent 1%),
          radial-gradient(circle at 85% 79%, rgba(109, 80, 52, 0.55) 0%, transparent 1%),
          linear-gradient(145deg, var(--cc-stone-light) 0%, var(--cc-stone-dark) 100%);
        background-repeat: no-repeat;
        background-size: 100% 100%;
        border: 1px solid var(--cc-stone-bezel);
        border-radius: 4px;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.45),
          0 1px 1px rgba(0, 0, 0, 0.2);
        padding: 0.05rem 0.35rem;
        color: var(--cc-ink);
        font-size: inherit;
        font-family: inherit;
        cursor: pointer;

        // Flat maroon fill (same --cc-banner/--cc-banner-text pairing used
        // on .cc-attribute-roll's hover) rather than the stone texture, so
        // the hover state reads as a clear "armed to roll" state change
        // instead of just a lighting shift on the same stone.
        &:hover {
          background-image: none;
          background-color: var(--cc-banner);
          border-color: var(--cc-banner);
          color: var(--cc-banner-text);
        }

        &:before {
          content: '0';
          font-size: 1.4em;
          opacity: 0.9;
        }
      }
    }
  }

