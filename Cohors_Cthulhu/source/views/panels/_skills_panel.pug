//- views/panels/_skills_panel.pug
//- Skills table (+skill, source/components/_skill.pug) with their Focuses.
//- Resilience's extraAffects reruns the Max Stress calculations.
.cc-panel.cc-skills
  .cc-banner Skills
  table.cc-table.cc-skills-table
    thead
      tr
        th Skill
        th Ranks
        th Focuses
    tbody
      +skill('academia', ['Finance', 'History', 'Linguistics', 'Philosophy', 'Religion'])
      +skill('athletics', ['Climbing', 'Lifting', 'Physical Training', 'Running', 'Swimming'])
      +skill('crafting', ['Armorsmithing', 'Cooking', 'Tailoring', 'Weaponsmithing'])
      +skill('engineering', ['Architecture', 'Defenses', 'Demolition', 'Infrastructure', 'Siege Engines'])
      +skill('fighting', ['Archery', 'Melee Weapons', 'Thrown Weapons', 'Unarmed', 'War Magic'])
      +skill('medicine', ['Contagion', 'Faith Healing', 'Field Treatment', 'Pharmacia', 'Surgery'])
      +skill('observation', ['Hearing', 'Instincts', 'Sight', 'Smell and Taste'])
      +skill('persuasion', ['Charm', 'Deception', 'Innuendo', 'Intimidation', 'Invocation', 'Negotiation', 'Rhetoric'])
      +skill('resilience', ['Discipline', 'Fortitude', 'Immunity'], ['stress_max_base', 'stress_max', 'stress_max_marker', 'fatigue_max_marker'])
      +skill('stealth', ['Concealment', 'Disguise', 'Escape Artistry', 'Lock Picking', 'Sleight of Hand', 'Sneak'])
      +skill('survival', ['Animal Handling', 'Boating', 'Foraging', 'Hunting', 'Mysticism', 'Navigation', 'Tracking', 'Woodcraft'])
      +skill('tactics', ['Cavalry', 'Infantry', 'Leadership', 'Navy', 'Omen Reading', 'Scouting'])

+scss.
  .cc-character {
    .cc-skills-table {
      th,
      td {
        vertical-align: middle;
        min-height: 2.6rem;
      }

      // No divider under the Ranks column.
      td.cc-skill-ranks-cell {
        border-bottom: none;
      }

      // Same button treatment as .cc-attribute-roll, at a fixed width that
      // fits the longest skill name.
      .cc-skill-name-roll {
        display: inline-flex;
        align-items: center;
        justify-content: flex-start;
        gap: 0.3rem;
        width: 8.5rem;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid var(--cc-banner-text);
        border-radius: 4px;
        padding: 0.15rem 0.5rem;
        color: inherit;
        font: inherit;
        text-transform: inherit;
        letter-spacing: inherit;
        white-space: nowrap;
        cursor: pointer;

        &:hover {
          background: var(--cc-banner-text);
          color: var(--cc-banner);
        }

        &:before {
          content: '0';
          font-size: 1.5em;
          opacity: 1;
        }
      }

      // Always player-entered.
      .cc-skill-ranks {
        width: 3rem;
        text-align: center;
        background: var(--cc-editable-fill);
        border: 1px solid var(--cc-rule);
        color: var(--cc-ink);
      }

      td.cc-skill-focuses {
        display: flex;
        flex-wrap: wrap;
        align-content: center;
        align-items: center;
        gap: 0.15rem 0.6rem;
      }
    }

    .cc-focus-item {
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
      font-size: 0.8rem;
      white-space: nowrap;

      // k-scaffold's checkbox border doesn't apply; set it here.
      .cc-focus-checkbox {
        margin: 0;
        width: 0.8rem !important;
        height: 0.8rem !important;
        min-width: 0.8rem !important;
        min-height: 0.8rem !important;
        border: 1px solid var(--cc-rule) !important;
        // Same light fill as the ratings, ranks and tracker boxes.
        background-color: var(--cc-editable-fill) !important;
      }

      // Stone-block pill (see --cc-stone-* in scss/_variables.scss), smaller
      // than the skill button. The flecks are radial-gradient dots, not an
      // image.
      .cc-focus-roll {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        background-image:
          radial-gradient(circle at 41% 31%, rgba(74, 53, 30, 0.6) 0%, transparent 5%),
          radial-gradient(circle at 85% 56%, rgba(92, 74, 48, 0.5) 0%, transparent 4%),
          radial-gradient(circle at 54% 41%, rgba(92, 74, 48, 0.5) 0%, transparent 4%),
          radial-gradient(circle at 56% 71%, rgba(92, 74, 48, 0.5) 0%, transparent 3%),
          radial-gradient(circle at 79% 45%, rgba(92, 74, 48, 0.5) 0%, transparent 3%),
          radial-gradient(circle at 21% 67%, rgba(92, 74, 48, 0.5) 0%, transparent 3%),
          radial-gradient(circle at 63% 59%, rgba(92, 74, 48, 0.5) 0%, transparent 3%),
          radial-gradient(circle at 76% 11%, rgba(109, 80, 52, 0.55) 0%, transparent 2%),
          radial-gradient(circle at 81% 26%, rgba(109, 80, 52, 0.55) 0%, transparent 2%),
          radial-gradient(circle at 71% 19%, rgba(109, 80, 52, 0.55) 0%, transparent 2%),
          radial-gradient(circle at 16% 85%, rgba(109, 80, 52, 0.55) 0%, transparent 2%),
          radial-gradient(circle at 93% 12%, rgba(109, 80, 52, 0.55) 0%, transparent 1%),
          radial-gradient(circle at 61% 59%, rgba(109, 80, 52, 0.55) 0%, transparent 1%),
          radial-gradient(circle at 85% 79%, rgba(109, 80, 52, 0.55) 0%, transparent 1%),
          linear-gradient(145deg, var(--cc-stone-light) 0%, var(--cc-stone-dark) 100%);
        background-repeat: no-repeat;
        background-size: 100% 100%;
        border: 1px solid var(--cc-stone-bezel);
        border-radius: 4px;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.45),
          0 1px 1px rgba(0, 0, 0, 0.2);
        padding: 0.05rem 0.35rem;
        color: var(--cc-ink);
        font-size: inherit;
        font-family: inherit;
        cursor: pointer;

        // Flat maroon fill on hover.
        &:hover {
          background-image: none;
          background-color: var(--cc-banner);
          border-color: var(--cc-banner);
          color: var(--cc-banner-text);
        }

        &:before {
          content: '0';
          font-size: 1.4em;
          opacity: 0.9;
        }
      }
    }
  }

+module.
  // The rules don't fix which attribute goes with a skill, so both rolls ask
  // via ccAttributeQuery.
  //
  // Plain skill roll: crit only on a natural 1.
  const initiateSkillRoll = async ({trigger, attributes}) => {
    const skill = ccNormalizeName(trigger.name).replace(/_skill_(roll|action)$/, '');
    const skillRanks = Number(attributes[`${skill}_ranks`]) || 0;
    await runCcRoll({
      attributes,
      skillLabel: ccCapitalize(skill),
      focusLabel: '',
      attributeExpr: ccAttributeQuery(attributes),
      skillRanks,
      critMax: 1,
    });
  };
  k.registerFuncs({initiateSkillRoll});

  // Focus roll: crit on a die <= the skill's ranks; a natural 1 always
  // crits, even with 0 ranks.
  const initiateFocusRoll = async ({trigger, attributes}) => {
    const match = ccNormalizeName(trigger.name).match(/^(.+)_focus_(.+)_(?:roll|action)$/);
    if (!match) { return; }
    const [, skill, focusSlug] = match;
    const skillRanks = Number(attributes[`${skill}_ranks`]) || 0;
    await runCcRoll({
      attributes,
      skillLabel: ccCapitalize(skill),
      focusLabel: ccCapitalize(focusSlug),
      attributeExpr: ccAttributeQuery(attributes),
      skillRanks,
      critMax: Math.max(1, skillRanks),
    });
  };
  k.registerFuncs({initiateFocusRoll});
