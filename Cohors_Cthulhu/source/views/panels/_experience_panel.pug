//- views/panels/_experience_panel.pug
//- Experience panel. Pure single-panel logic - calcXpAvailable only reads
//- this panel's own xp_earned/xp_spent fields.
.cc-panel.cc-experience
  .cc-banner Experience
  .cc-field-group
    .cc-field
      span Earned
      +number({name: 'xp earned', trigger: {affects: ['xp_available']}})
    .cc-field
      span Spent
      +number({name: 'xp spent', trigger: {affects: ['xp_available']}})
    .cc-field
      span Available
      +number({name: 'xp available', readonly: true, trigger: {calculation: 'calcXpAvailable'}})

+module.
  const calcXpAvailable = ({attributes}) => {
    return (Number(attributes.xp_earned) || 0) - (Number(attributes.xp_spent) || 0);
  };
  k.registerFuncs({calcXpAvailable});
