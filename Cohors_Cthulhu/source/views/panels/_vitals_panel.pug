      align-self: flex-start;
      // Without an explicit gap, adjacent checked boxes share the same
      // fill/border color and their touching edges disappear, so what
      // should be distinct boxes reads as one solid blob - same fix as
      // .cc-stress-track above.
      --fillLeftSelectedColor: var(--cc-rule);
      --fillLeftUnselectedColor: var(--cc-parchment);

      .fill-left__radio {
        width: 0.9rem;
        height: 0.9rem;
        border: 1px solid var(--cc-rule);
        padding: 0;
        margin: 0;
      }
    }

    .cc-vitals-fatigue {
      margin-top: 0.5rem;
      padding-top: 0.4rem;
      border-top: 1px dashed var(--cc-rule-soft);
    }

    // Same construction as .cc-stress-track above (20 action-button boxes,
    // hidden value=0 anchor, hidden value-mirroring radios driving
