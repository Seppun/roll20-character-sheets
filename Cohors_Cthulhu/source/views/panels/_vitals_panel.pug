  .cc-character {
    // Two of the five tracks (2 and 4) are deliberately empty spacers
    // rather than a gap, so the content tracks (1/3/5) can be sized
    // independently of the space between them - .cc-vitals-stress/
    // -courage-armor/-injuries-fortune below are placed explicitly onto
    // 1/3/5, skipping the spacer tracks.
    .cc-vitals {
      display: grid;
      grid-template-columns: 1.5fr 0.4fr 1fr 0.4fr 1.6fr;
      align-items: start;
    }

    .cc-vitals-stress {
      grid-column: 1;
    }

    .cc-vitals-courage-armor {
      grid-column: 3;
    }

    .cc-vitals-injuries-fortune {
      grid-column: 5;
    }

    .cc-vitals-courage-armor,
    .cc-vitals-injuries-fortune {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    // .cc-field/.cc-vitals-injuries are flex columns (see below), which
    // stretches their .cc-banner child to the field's full width by
    // default (align-items: stretch) - the banner's brush-stroke
    // background then stretches with it instead of sitting under just
    // the text. align-self: flex-start opts the banner back out to its
    // own content width; .cc-vitals-stress/-fatigue's banners aren't
    // flex items in the first place, so this has no effect on them.
    .cc-vitals .cc-banner {
      align-self: flex-start;
    }

    // Overrides the generic .cc-field column layout (label above value) to
    // put Max and Current Max on one shared line instead of a standalone
    // "MAX" heading with a boxed number underneath - it sits below the
    // already full-width stress track, not beside other stacked fields.
    .cc-stress-max {
      flex-direction: row;
      align-items: baseline;
      gap: 0.4rem;
    }

    // The value=0 anchor radio in .cc-stress-track/.cc-fortune-track/
    // .cc-fatigue-track (see the pug comment above .cc-stress-track) never
    // needs to be visible itself - only its checked state matters for the
    // sibling-selector coloring below, same as .cc-track-value-marker and
    // .cc-stress-max-marker.
    .cc-fill-left-zero {
      display: none;
    }

    // Hidden radio group mirroring each track's own live value (see the
    // pug comment above .cc-stress-track) - exists purely so its :checked
    // state can drive the coloring rule below; the player never interacts
    // with these directly, only with the +action button boxes they sit
    // beside. --fillLeftUnselectedColor resolves per track (each of
    // .cc-stress-track/.cc-fortune-track/.cc-fatigue-track defines its
    // own copy of the same value below) since custom properties cascade
    // normally despite this rule living outside any of those selectors.
    .cc-track-value-marker {
      display: none;
    }

    .cc-track-value-marker:checked ~ .fill-left__radio {
      background-color: var(--fillLeftUnselectedColor);
    }

    .cc-stress-track {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      gap: 0.15rem;
      // k-scaffold's fillLeft mixin colors every box --fillLeftSelectedColor
      // by default, then overrides everything AFTER the checked box (in DOM/
      // numeric order) to --fillLeftUnselectedColor - so the checked box and
      // everything below it stays "selected"-colored, and everything above
      // it becomes "unselected"-colored. --cc-rule (dark) must be the
      // selected color and --cc-parchment (light) the unselected one, or the
      // filled/empty look is inverted.
      --fillLeftSelectedColor: var(--cc-rule);
      --fillLeftUnselectedColor: var(--cc-parchment);

      // appearance/background/cursor come from k-scaffold's own
      // .fill-left__radio rule, which applies equally whether the element
      // is a button (this track's visible boxes) or an input (the
      // value=0/marker radios elsewhere here) - width/height/border/
      // padding/margin reset what a bare button would otherwise bring in
      // on top of that.
      .fill-left__radio {
        width: 0.9rem;
        height: 0.9rem;
        border: 1px solid var(--cc-rule);
        padding: 0;
        margin: 0;
      }

      // The hidden stress-max-marker radios (see the pug comment above
      // .cc-stress-track) never need to be visible themselves - only
      // their checked state matters, which display:none doesn't affect.
      .cc-stress-max-marker {
        display: none;
      }

      // Grey out and disable every visible box past the checked marker -
      // i.e. every value greater than stress_max, since the marker with
      // that same value sits immediately after its matching visible box
      // (see the pug comment above). pointer-events prevents clicking a
      // disabled box back to "selected" (a plain visual dim wouldn't stop
      // that); a real HTML disabled attribute isn't an option since it
      // can't be toggled at runtime from a sheet worker.
      .cc-stress-max-marker:checked ~ .fill-left__radio {
        opacity: 0.35;
        pointer-events: none;
      }
    }

    .cc-fortune-track {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0.15rem;
      // k-scaffold's fillLeft mixin centers its construct by default
      // (--fillLeftAlignment: center, applied via align-self on the flex
