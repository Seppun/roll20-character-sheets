    .cc-fatigue-track {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      gap: 0.15rem;
      --fillLeftSelectedColor: var(--cc-rule);
      --fillLeftUnselectedColor: var(--cc-parchment);

      .fill-left__radio {
        width: 0.9rem;
        height: 0.9rem;
        border: 1px solid var(--cc-rule);
        padding: 0;
        margin: 0;
      }

      .cc-fatigue-max-marker {
        display: none;
      }

      .cc-fatigue-max-marker:checked ~ .fill-left__radio {
        opacity: 0.35;
        pointer-events: none;
      }
    }

    .cc-fatigue-ignore {
      flex-direction: row;
      align-items: center;
      gap: 0.3rem;
      margin-top: 0.3rem;

      // Restores a plain, visible checkbox appearance overridden by
