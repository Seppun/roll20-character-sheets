//- views/panels/_vitals_panel.pug
//- Stress/Fatigue/Courage/Fortune/Armor-summary/Injuries panel. Base
//- Armour and Total Armor are DISPLAYED here but calculated from Attributes'
//- brawn_rating and panels/_armor_panel.pug's own repeating rows - that's
//- fine with no cross-file JS coupling, since Roll20 populates the
//- `attributes` bag passed into any sheet-worker call purely by attribute
//- NAME, regardless of which file's markup declared that attribute. Only a
//- function called by direct JS reference from another file (not just
//- named in a trigger/affects string) needs to live in
//- views/_global_sheetworker.pug instead - see that file's own comment.
.cc-panel.cc-vitals
  .cc-vitals-stress
    .cc-banner Stress
    //- Hand-expanded from +fillLeft (see .cc-stress-track below for the
    //- fill coloring). Each visible box is an +action button rather than
    //- a radio/checkbox, so every click is a real sheet-worker event -
    //- ccTrackBoxClick below decides what it means, including clearing
    //- the whole track to 0 when box 1 is clicked while it's the only box
    //- filled (there's no separate Clear button for that reason). See
    //- lessons_learned.md for why a plain radio/checkbox group can't do
    //- this on its own.
    //-
    //- The fill coloring itself comes from a second, hidden radio group -
    //- one radio per box, named the same as the tracked attribute
    //- ('stress') so Roll20 keeps the correct one checked whenever
    //- ccTrackBoxClick writes a new value. Each hidden radio sits right
    //- after its box so `:checked ~ .fill-left__radio` (see
    //- .cc-track-value-marker's rule below) greys out every box after the
    //- current value, the same mechanism .cc-stress-max-marker uses below
    //- for the max-value boundary. The value=0 radio makes the "nothing
    //- taken yet" all-empty look reachable, and must be a real (hidden)
    //- radio, not a literal +hidden() input - a genuine type="hidden"
    //- input can never match :checked.
    .cc-stress-track
      +radio({name: 'stress', value: 0, checked: ''}).fill-left__radio.cc-fill-left-zero
      //- A value=0 member of its own - without one, a brand-new
      //- character (calcStressMax = 0) has no radio in this group
      //- matching the calculated value, so every stress box stays
      //- enabled despite a Max Stress of 0.
      +radio({name: 'stress max marker', value: 0, trigger: {calculation: 'calcStressMax'}}).cc-stress-max-marker
      each value in Array.from({length: 20}, (_, i) => i + 1)
        +action({
          name: `stress box ${value}`,
          trigger: {triggeredFuncs: ['ccTrackBoxClick']}
        }).fill-left__radio
        +radio({name: 'stress', value}).cc-track-value-marker
        +radio({
          name: 'stress max marker',
          value,
          trigger: {calculation: 'calcStressMax'}
        }).cc-stress-max-marker
    //- "Max" is the character's raw stress capacity (brawn/will +
    //- resilience + Unyielding, see calcStressMaxBase) - unaffected by
    //- Fatigue. "Current Max" is that same value less current Fatigue
    //- (calcStressMax, floored at 0) - the actual ceiling the Stress
    //- track itself is limited to right now (see .cc-stress-max-marker
    //- below). Two separate attributes/fields rather than one relabeled
    //- field so a player can always see both the character's innate
    //- maximum and how much Fatigue is currently eating into it - both
    //- on one shared line to keep the panel compact.
    .cc-field.cc-stress-max
      span Max
      +number({name: 'stress max base', readonly: true, trigger: {calculation: 'calcStressMaxBase'}})
      span Current Max
      +number({name: 'stress max', readonly: true, trigger: {calculation: 'calcStressMax'}})
    //- Fatigue (page 41): each point temporarily reduces Max Stress by
    //- 1 (floored at 0 by calcStressMax - reaching 0 there means
    //- Defeated per RAW, not something this sheet can detect/flag on
    //- its own since "collapsing from exhaustion" isn't a distinct
    //- tracked state anywhere else here). Same hand-expanded fill-left
    //- track as Stress above (action-button boxes + a hidden
    //- value-mirroring radio group, see that block's comment for the
    //- full explanation) - the 'affects' on each box's trigger is the
    //- only difference, re-running calcStressMax since Fatigue
    //- changes it. Fatigue also can't exceed the character's raw Max
    //- Stress (calcStressMaxBase, NOT the Fatigue-reduced Current Max -
    //- that would be self-referential, Fatigue capping its own cap) -
    //- .cc-fatigue-max-marker below greys out/disables every box past
    //- that boundary, the same way .cc-stress-max-marker already does
    //- for the Stress track above.
    .cc-vitals-fatigue
      .cc-banner Fatigue
      .cc-fatigue-track
        +radio({name: 'fatigue', value: 0, checked: ''}).fill-left__radio.cc-fill-left-zero
        //- A value=0 member of its own, same reason as the Stress
        //- track's own value=0 marker above.
        +radio({name: 'fatigue max marker', value: 0, trigger: {calculation: 'calcStressMaxBase'}}).cc-fatigue-max-marker
        each value in Array.from({length: 20}, (_, i) => i + 1)
          +action({
            name: `fatigue box ${value}`,
            trigger: {triggeredFuncs: ['ccTrackBoxClick'], affects: ['stress_max', 'stress_max_marker']}
          }).fill-left__radio
          +radio({name: 'fatigue', value}).cc-track-value-marker
          +radio({
            name: 'fatigue max marker',
            value,
            trigger: {calculation: 'calcStressMaxBase'}
          }).cc-fatigue-max-marker
      .cc-field.cc-fatigue-ignore
        //- "Fatigue can also be temporarily ignored" - checking this
        //- stops it from reducing Max Stress (see calcStressMax)
        //- without discarding the tracked fatigue value itself, since
        //- the fatigue hasn't actually been removed, just pushed
        //- through for now.
        +checkbox({
          name: 'fatigue ignored',
          value: 1,
          id: 'cc-fatigue-ignored',
          trigger: {affects: ['stress_max', 'stress_max_marker']}
        })
        label(for='cc-fatigue-ignored') Ignore Fatigue (temporarily)
      +action({
        name: 'fatigue resist',
        class: 'cc-fatigue-resist roller',
        trigger: {triggeredFuncs: ['initiateFatigueResistRoll'], affects: ['stress_max', 'stress_max_marker']}
      })
        | Resist Fatigue
  .cc-vitals-courage-armor
    .cc-field
      .cc-banner Courage
      +number({name: 'courage', readonly: true, trigger: {calculation: 'calcCourage'}})
    .cc-field
      .cc-banner Base Armour
      +number({name: 'base armour', readonly: true, trigger: {calculation: 'calcBaseArmour', affects: ['total_armor']}})
    .cc-field
      .cc-banner Total Armor
      +number({name: 'total armor', readonly: true, trigger: {calculation: 'calcTotalArmor'}})
  .cc-vitals-injuries-fortune
    .cc-vitals-injuries
      .cc-banner Injuries
      +textarea({name: 'injuries'}).cc-injuries
    .cc-field
      .cc-banner Fortune
      //- Hand-expanded rather than using +fillLeft directly, same as
      //- .cc-stress-track above and for the same reason (action-button
      //- boxes + a hidden value-mirroring radio group) - see that
      //- block's comment for the full explanation.
      .cc-fortune-track
        +radio({name: 'fortune', value: 0, checked: ''}).fill-left__radio.cc-fill-left-zero
        each value in [1, 2, 3, 4, 5]
          +action({
            name: `fortune box ${value}`,
            trigger: {triggeredFuncs: ['ccTrackBoxClick']}
          }).fill-left__radio
          +radio({name: 'fortune', value}).cc-track-value-marker

