//- views/_combat.pug
//- Page 2 of the official sheet: Belongings and Talents.
//- Weapons and Armor moved to the Character tab, alongside Skills, since
//- those are the sections used most often during play.
+tab({name: 'combat', container: 'article'})
  .cc-page.cc-combat

    .cc-panel.cc-belongings
      .cc-banner(data-i18n='belongings') Belongings
      +textarea({name: 'belongings'})

    .cc-panel.cc-talents
      .cc-banner(data-i18n='talents') Talents
      .cc-rep-table.cc-rep-talents
        .cc-rep-header
          span(data-i18n='name') Name
          span(data-i18n='keywords') Keywords
          span(data-i18n='description') Description
        +fieldset({name: 'talent'})
          +text({name: 'name'})
          +text({name: 'keywords'})
          +textarea({name: 'description'})

+scss.
  .cc-combat {
    .cc-rep-talents {
      .cc-rep-header,
      fieldset,
      .repcontainer .repitem {
        grid-template-columns: 1fr 1fr 3fr;
      }

      textarea {
        min-height: 3rem;
      }
    }

    .cc-belongings textarea {
      min-height: 6rem;
      width: 100%;
      background: transparent;
      border: 1px solid var(--cc-rule);
      color: var(--cc-ink);
    }
  }
