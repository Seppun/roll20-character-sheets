//- views/_character.pug
//- Page 1 of the official sheet (identity header, truths & scars, stress /
//- armor / injuries / courage / fortune, attributes, skills, languages, xp)
//- plus Weapons and Armor from page 2, grouped here with Skills since
//- these are the sections used most often during play.
+tab({name: 'character', container: 'article'})
  .cc-page.cc-character

    .cc-banner Cohors Cthulhu
    .cc-field-group
      .cc-field
        span(data-i18n='name & pronoun') Name & Pronoun
        +text({name: 'name pronoun'})
      .cc-field
        span(data-i18n='culture') Culture
        +text({name: 'culture'})
      .cc-field
        span(data-i18n='caste') Caste
        +text({name: 'caste'})
      .cc-field
        span(data-i18n='wealth') Wealth
        +text({name: 'wealth'})
    .cc-field-group
      .cc-field
        span(data-i18n='archetype') Archetype
        +text({name: 'archetype'})
      .cc-field
        span(data-i18n='background') Background
        +text({name: 'background'})
      .cc-field
        span(data-i18n='characteristic') Characteristic
        +text({name: 'characteristic'})

    .cc-panel.cc-truths-scars
      .cc-banner(data-i18n='personal truths and scars') Personal Truths &amp; Scars
      .cc-truths-scars-grid
        each n in [1, 2, 3, 4, 5]
          +text({name: `truth ${n}`}).cc-truth
        each n in [1, 2, 3, 4, 5]
          +text({name: `scar ${n}`}).cc-scar

    .cc-panel.cc-vitals
      .cc-vitals-stress
        .cc-banner(data-i18n='stress') Stress
        +fillLeft({
          radioObj: {name: 'stress'},
          valueArray: Array.from({length: 20}, (_, i) => i + 1)
        }).cc-stress-track
        .cc-field.cc-stress-max
          span(data-i18n='stress max') Max
          +number({name: 'stress max', readonly: true, trigger: {calculation: 'calcStressMax'}})
      .cc-vitals-courage-fortune
        .cc-field
          span(data-i18n='courage') Courage
          +number({name: 'courage', readonly: true, trigger: {calculation: 'calcCourage'}})
        .cc-field
          span(data-i18n='fortune') Fortune
          +fillLeft({
            radioObj: {name: 'fortune'},
            valueArray: [1, 2, 3, 4, 5]
          }).cc-fortune-track
      .cc-vitals-armor
        .cc-field
          span(data-i18n='base armour') Base Armour
          +number({name: 'base armour', readonly: true, trigger: {calculation: 'calcBaseArmour', affects: ['total_armor']}})
        .cc-field
          span(data-i18n='total armor') Total Armor
          +number({name: 'total armor', readonly: true, trigger: {calculation: 'calcTotalArmor'}})
      .cc-vitals-injuries
        .cc-banner(data-i18n='injuries') Injuries
        +textarea({name: 'injuries'}).cc-injuries

    - const ccAttributes = ['agility', 'brawn', 'coordination', 'gravitas', 'insight', 'reason', 'will']
    - const ccBonusDamageAttributes = ['brawn', 'insight', 'will']
    -
      const ccRatingAffects = {
        brawn: ['brawn_bonus_damage', 'base_armour', 'total_armor', 'stress_max'],
        will: ['will_bonus_damage', 'courage', 'stress_max', 'power_rating'],
        insight: ['insight_bonus_damage', 'power_rating'],
        reason: ['power_rating'],
      }
    .cc-panel.cc-attributes
      .cc-banner(data-i18n='attributes') Attributes
      table.cc-table.cc-attributes-table
        thead
          tr
            th
            each attr in ccAttributes
              th(data-i18n=attr)= attr
        tbody
          tr
            th(data-i18n='rating') Rating
            each attr in ccAttributes
              td
                +number({
                  name: `${attr} rating`,
                  trigger: ccRatingAffects[attr] ? {affects: ccRatingAffects[attr]} : undefined
                }).cc-attribute-rating
          tr
            th(data-i18n='bonus damage') Bonus Damage
            each attr in ccAttributes
              td
                if ccBonusDamageAttributes.includes(attr)
                  +number({
                    name: `${attr} bonus damage`,
                    readonly: true,
                    trigger: {calculation: 'calcAttributeBonusDamage'}
                  }).cc-attribute-bonus-damage
                else
                  span.cc-attribute-bonus-damage.cc-disabled

    .cc-panel.cc-skills
      .cc-banner(data-i18n='skills') Skills
      table.cc-table.cc-skills-table
        thead
          tr
            th(data-i18n='skill') Skill
            th(data-i18n='ranks') Ranks
            th(data-i18n='focuses') Focuses
        tbody
          +skill('academia', ['Finance', 'History', 'Linguistics', 'Philosophy', 'Religion'])
          +skill('athletics', ['Climbing', 'Lifting', 'Physical Training', 'Running', 'Swimming'])
          +skill('crafting', ['Armorsmithing', 'Cooking', 'Tailoring', 'Weaponsmithing'])
          +skill('engineering', ['Architecture', 'Defenses', 'Demolition', 'Infrastructure', 'Siege Engines'])
          +skill('fighting', ['Archery', 'Melee Weapons', 'Thrown Weapons', 'Unarmed', 'War Magic'])
          +skill('medicine', ['Contagion', 'Faith Healing', 'Field Treatment', 'Pharmacia', 'Surgery'])
          +skill('observation', ['Hearing', 'Instincts', 'Sight', 'Smell and Taste'])
          +skill('persuasion', ['Charm', 'Deception', 'Innuendo', 'Intimidation', 'Invocation', 'Negotiation', 'Rhetoric'])
          +skill('resilience', ['Discipline', 'Fortitude', 'Immunity'], ['stress_max'])
          +skill('stealth', ['Concealment', 'Disguise', 'Escape Artistry', 'Lock Picking', 'Sleight of Hand', 'Sneak'])
          +skill('survival', ['Animal Handling', 'Boating', 'Foraging', 'Hunting', 'Mysticism', 'Navigation', 'Tracking', 'Woodcraft'])
          +skill('tactics', ['Cavalry', 'Infantry', 'Leadership', 'Navy', 'Omen Reading', 'Scouting'])

    .cc-panel.cc-weapons
      .cc-banner(data-i18n='weapons') Weapons
      .cc-rep-table.cc-rep-weapons
        .cc-rep-header
          span(data-i18n='name') Name
          span(data-i18n='focus') Focus
          span(data-i18n='reach or range') Reach or Range
          span(data-i18n='damage and effects') Damage &amp; Effects
          span(data-i18n='size') Size
          span(data-i18n='qualities') Qualities
        +fieldset({name: 'weapon'})
          +text({name: 'name'})
          +text({name: 'focus'})
          +text({name: 'reach range'})
          +text({name: 'damage effects'})
          +text({name: 'size'})
          +text({name: 'qualities'})

    .cc-panel.cc-armor
      .cc-banner(data-i18n='armor') Armor
      .cc-rep-table.cc-rep-armor
        .cc-rep-header
          span(data-i18n='name') Name
          span(data-i18n='resistance') Resistance
          span(data-i18n='qualities') Qualities
        +fieldset({name: 'armor'})
          +text({name: 'name'})
          +number({name: 'resistance', trigger: {affects: ['total_armor']}})
          +text({name: 'qualities'})

    .cc-field-group
      .cc-field.cc-languages
        span(data-i18n='languages') Languages
        +textarea({name: 'languages'})
      .cc-panel.cc-experience
        .cc-banner(data-i18n='experience') Experience
        .cc-field-group
          .cc-field
            span(data-i18n='xp earned') Earned
            +number({name: 'xp earned', trigger: {affects: ['xp_available']}})
          .cc-field
            span(data-i18n='xp spent') Spent
            +number({name: 'xp spent', trigger: {affects: ['xp_available']}})
          .cc-field
            span(data-i18n='xp available') Available
            +number({name: 'xp available', readonly: true, trigger: {calculation: 'calcXpAvailable'}})

+scss.
  .cc-character {
    .cc-truths-scars-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0.3rem;

      .cc-truth,
      .cc-scar {
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--cc-rule);
        color: var(--cc-ink);
        padding: 0.15rem 0.1rem;
      }
    }

    .cc-vitals {
      display: grid;
      grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
      gap: 0.75rem;
      align-items: start;
    }

    .cc-vitals-courage-fortune,
    .cc-vitals-armor {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .cc-stress-track {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      gap: 0.15rem;
      --fillLeftSelectedColor: var(--cc-parchment);
      --fillLeftUnselectedColor: var(--cc-rule);

      .fill-left__radio {
        width: 0.9rem;
        height: 0.9rem;
        border: 1px solid var(--cc-rule);
      }
    }

    .cc-fortune-track {
      --fillLeftSelectedColor: var(--cc-parchment);
      --fillLeftUnselectedColor: var(--cc-rule);

      .fill-left__radio {
        width: 0.9rem;
        height: 0.9rem;
        border: 1px solid var(--cc-rule);
      }
    }

    .cc-injuries {
      display: flex;
      flex-direction: column;

      .cc-injuries {
        flex: 1;
        min-height: 4rem;
      }
    }

    .cc-attributes-table {
      th,
      td {
        text-align: center;
        vertical-align: middle;
      }

      th:first-child {
        text-align: left;
      }

      .cc-attribute-rating,
      .cc-attribute-bonus-damage {
        width: 3rem;
        text-align: center;
        background: transparent;
        border: 1px solid var(--cc-rule);
        color: var(--cc-ink);
        border-radius: 2px;
      }

      .cc-attribute-bonus-damage.cc-disabled {
        display: inline-block;
        width: 3rem;
        height: 1.6rem;
        border: 1px dashed var(--cc-parchment-dark);
      }
    }

    .cc-skills-table {
      th,
      td {
        vertical-align: middle;
        min-height: 2.6rem;
      }

      // No row-divider under the Ranks column - only the Skill/Focuses
      // columns carry the row-separator line.
      td.cc-skill-ranks-cell {
        border-bottom: none;
      }

      .cc-skill-ranks {
        width: 3rem;
        text-align: center;
        background: transparent;
        border: 1px solid var(--cc-rule);
        color: var(--cc-ink);
      }

      td.cc-skill-focuses {
        display: flex;
        flex-wrap: wrap;
        align-content: center;
        align-items: center;
        gap: 0.15rem 0.6rem;
      }
    }

    .cc-focus-item {
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
      font-size: 0.8rem;
      font-style: italic;
      white-space: nowrap;

      // k-scaffold's default checkbox border relies on a mistyped custom
      // property upstream (--checkboxBorderColor falls back to an
      // undefined --checkboxBorderColor variable), which drops the whole
      // border declaration - so checkboxes render invisible unless we
      // set it explicitly here.
      .cc-focus-checkbox {
        margin: 0;
        width: 0.8rem !important;
        height: 0.8rem !important;
        min-width: 0.8rem !important;
        min-height: 0.8rem !important;
        border: 1px solid var(--cc-rule) !important;
        background: var(--cc-parchment) !important;
      }

      .cc-focus-roll {
        background: none;
        border: none;
        padding: 0;
        color: var(--cc-ink);
        font-style: italic;
        font-size: inherit;
        font-family: inherit;
        cursor: pointer;

        &:hover {
          color: var(--cc-rule);
          text-decoration: underline;
        }

        &:before {
          font-size: 0.75em;
          opacity: 0.6;
        }
      }
    }

    .cc-languages textarea {
      min-height: 4rem;
    }

    .cc-rep-weapons {
      .cc-rep-header,
      fieldset,
      .repcontainer .repitem {
        grid-template-columns: 1fr 1fr 1fr 2fr 0.6fr 1.4fr;
      }
    }

    .cc-rep-armor {
      .cc-rep-header,
      fieldset,
      .repcontainer .repitem {
        grid-template-columns: 1.5fr 1fr 2.5fr;
      }
    }
  }

+module.
  // Shared lookup table used by Bonus Damage, Base Armour, Courage, and
  // (in views/_spells.pug) spellcasting Power Rating. Rulebook table:
  // rating <=8 -> 0, 9 -> +1, 10-11 -> +2, 12-13 -> +3, 14-15 -> +4, 16+ -> +5.
  const ccAttributeBonus = (rating) => {
    const r = Number(rating) || 0;
    return r <= 8 ? 0 : Math.ceil((r - 7) / 2);
  };

  const calcAttributeBonusDamage = ({trigger, attributes}) => {
    const attrName = trigger.name.replace(/_bonus_damage$/, '');
    return ccAttributeBonus(attributes[`${attrName}_rating`]);
  };
  k.registerFuncs({calcAttributeBonusDamage});

  const calcBaseArmour = ({attributes}) => ccAttributeBonus(attributes.brawn_rating);
  k.registerFuncs({calcBaseArmour});

  const calcCourage = ({attributes}) => ccAttributeBonus(attributes.will_rating);
  k.registerFuncs({calcCourage});

  const calcTotalArmor = ({attributes}) => {
    const base = ccAttributeBonus(attributes.brawn_rating);
    const armorRows = attributes.repeating_armor || [];
    const armorSum = armorRows.reduce((sum, row) => sum + (Number(row.resistance) || 0), 0);
    return base + armorSum;
  };
  k.registerFuncs({calcTotalArmor});

  // "Add your: Brawn + Resilience, or Will + Resilience (whichever is higher)."
  const calcStressMax = ({attributes}) => {
    const resilience = Number(attributes.resilience_ranks) || 0;
    const brawn = Number(attributes.brawn_rating) || 0;
    const will = Number(attributes.will_rating) || 0;
    return Math.max(brawn, will) + resilience;
  };
  k.registerFuncs({calcStressMax});

  const calcXpAvailable = ({attributes}) => {
    return (Number(attributes.xp_earned) || 0) - (Number(attributes.xp_spent) || 0);
  };
  k.registerFuncs({calcXpAvailable});

  // Rolling a Focus: 2d20 (plus any bought extra dice), target number =
  // chosen Attribute + this Skill's ranks, crit on a die <= this skill's
  // ranks (the focus always "applies" since this is a focus-specific
  // roller), complication on a die within the chosen complication range.
  const ccCapitalize = (s) => s.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

  const initiateFocusRoll = async ({trigger, attributes}) => {
    const match = trigger.name.match(/^(.+)_focus_(.+)_roll$/);
    if (!match) { return; }
    const [, skill, focusSlug] = match;
    const skillRanks = Number(attributes[`${skill}_ranks`]) || 0;

    const attributeQuery = '?{Attribute' +
      '|Agility,@{agility_rating}' +
      '|Brawn,@{brawn_rating}' +
      '|Coordination,@{coordination_rating}' +
      '|Gravitas,@{gravitas_rating}' +
      '|Insight,@{insight_rating}' +
      '|Reason,@{reason_rating}' +
      '|Will,@{will_rating}}';
    const difficultyQuery = '?{Difficulty|1}';
    const complicationQuery = '?{Complication range (1-5)|1}';
    const bonusDiceQuery = '?{Additional d20s bought (0-3)|0}';

    const roll = await startRoll(
      '&{template:cc-skill} ' +
      `{{character_name=@{character_name}}} ` +
      `{{skill=${ccCapitalize(skill)}}} ` +
      `{{focus=${ccCapitalize(focusSlug)}}} ` +
      `{{attribute_choice=[[0+${attributeQuery}]]}} ` +
      `{{difficulty=[[0+${difficultyQuery}]]}} ` +
      `{{complication_range=[[0+${complicationQuery}]]}} ` +
      `{{roll1=[[(2+${bonusDiceQuery})d20]]}}`
    );

    const attributeChoice = Number(roll.results.attribute_choice.result) || 0;
    const difficulty = Number(roll.results.difficulty.result) || 1;
    const complicationRange = Number(roll.results.complication_range.result) || 1;
    const dice = roll.results.roll1.dice;

    const targetNumber = attributeChoice + skillRanks;
    const complicationThreshold = 21 - complicationRange;
    const successCount = dice.filter((d) => d <= targetNumber).length +
      dice.filter((d) => d <= skillRanks).length;
    const complicationCount = dice.filter((d) => d >= complicationThreshold).length;
    const passed = successCount >= difficulty;

    const overrides = {
      target_number: targetNumber,
      successes: successCount,
      dice_text: dice.join(', '),
    };
    if (passed) {
      overrides.passed = 1;
      overrides.bonus_momentum = Math.max(0, successCount - difficulty);
    } else {
      overrides.failed = 1;
    }
    if (complicationCount > 0) {
      overrides.complications = complicationCount;
    }

    finishRoll(roll.rollId, overrides);
  };
  k.registerFuncs({initiateFocusRoll});
