      console.log(`[CC] ${skillLabel}${focusLabel ? ` (${focusLabel})` : ''} roll - d20s:`, dice);

      if (!dice.length) {
        finishRoll(roll.rollId, {
          target_number: '?',
          successes: '?',
          dice_text: `error: could not read dice from ${JSON.stringify(roll1)}`,
