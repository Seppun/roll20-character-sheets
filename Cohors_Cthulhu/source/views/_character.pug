  .cc-character {
    .cc-footer {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      margin-top: 0.4rem;
      padding-top: 0.2rem;
      border-top: 1px solid var(--cc-rule);
      font-size: 0.65rem;
      color: var(--cc-ink);
      opacity: 0.6;
    }

    // If this never appears in Roll20, the Sheet Style paste is stale -
    // this text lives only in the compiled CSS, not the HTML, so its
    // absence (or an older-looking value than .cc-build-html) means the
    // CSS box wasn't updated to match the last HTML paste.
    .cc-build-css::after {
      content: "CSS build: #{buildVersion}";
    }
    .cc-truths-scars-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0.3rem;

      .cc-truth,
      .cc-scar {
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--cc-rule);
        color: var(--cc-ink);
        padding: 0.15rem 0.1rem;
      }
    }

    .cc-vitals {
      display: grid;
      grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
      gap: 0.75rem;
      align-items: start;
    }

    .cc-vitals-courage-fortune,
    .cc-vitals-armor {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .cc-stress-track {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
      gap: 0.15rem;
      --fillLeftSelectedColor: var(--cc-parchment);
      --fillLeftUnselectedColor: var(--cc-rule);

      .fill-left__radio {
        width: 0.9rem;
        height: 0.9rem;
        border: 1px solid var(--cc-rule);
      }
    }

    .cc-fortune-track {
      --fillLeftSelectedColor: var(--cc-parchment);
      --fillLeftUnselectedColor: var(--cc-rule);

      .fill-left__radio {
        width: 0.9rem;
        height: 0.9rem;
        border: 1px solid var(--cc-rule);
      }
    }

    .cc-injuries {
      display: flex;
      flex-direction: column;

      .cc-injuries {
        flex: 1;
        min-height: 4rem;
      }
    }

    .cc-attributes-table {
      th,
      td {
        text-align: center;
        vertical-align: middle;
      }

      th:first-child {
        text-align: left;
      }

      .cc-attribute-roll {
        background: none;
        border: none;
        padding: 0;
        color: inherit;
        font: inherit;
        text-transform: inherit;
        letter-spacing: inherit;
        cursor: pointer;

        &:hover {
          text-decoration: underline;
        }

        &:before {
          font-size: 0.8em;
          opacity: 0.7;
        }
      }

      .cc-attribute-rating,
      .cc-attribute-bonus-damage {
        width: 3rem;
        text-align: center;
        background: transparent;
        border: 1px solid var(--cc-rule);
        color: var(--cc-ink);
        border-radius: 2px;
      }

      .cc-attribute-bonus-damage.cc-disabled {
        display: inline-block;
        width: 3rem;
        height: 1.6rem;
        border: 1px dashed var(--cc-parchment-dark);
      }
    }

    .cc-skills-table {
      th,
      td {
        vertical-align: middle;
        min-height: 2.6rem;
      }

      // No row-divider under the Ranks column - only the Skill/Focuses
      // columns carry the row-separator line.
      td.cc-skill-ranks-cell {
        border-bottom: none;
      }

      .cc-skill-name-roll {
        background: none;
        border: none;
        padding: 0;
        color: inherit;
        font: inherit;
        text-transform: inherit;
        letter-spacing: inherit;
        cursor: pointer;

        &:hover {
          text-decoration: underline;
        }

        &:before {
          font-size: 0.8em;
          opacity: 0.7;
        }
      }

      .cc-skill-ranks {
        width: 3rem;
        text-align: center;
        background: transparent;
        border: 1px solid var(--cc-rule);
        color: var(--cc-ink);
      }

      td.cc-skill-focuses {
        display: flex;
        flex-wrap: wrap;
        align-content: center;
        align-items: center;
        gap: 0.15rem 0.6rem;
      }
    }

    .cc-focus-item {
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
      font-size: 0.8rem;
      font-style: italic;
      white-space: nowrap;

      // k-scaffold's default checkbox border relies on a mistyped custom
      // property upstream (--checkboxBorderColor falls back to an
      // undefined --checkboxBorderColor variable), which drops the whole
      // border declaration - so checkboxes render invisible unless we
      // set it explicitly here.
      .cc-focus-checkbox {
        margin: 0;
        width: 0.8rem !important;
        height: 0.8rem !important;
        min-width: 0.8rem !important;
        min-height: 0.8rem !important;
        border: 1px solid var(--cc-rule) !important;
        background: var(--cc-parchment) !important;
      }

      .cc-focus-roll {
        background: none;
        border: none;
        padding: 0;
        color: var(--cc-ink);
        font-style: italic;
        font-size: inherit;
        font-family: inherit;
        cursor: pointer;

        &:hover {
          color: var(--cc-rule);
          text-decoration: underline;
        }

        &:before {
          font-size: 0.75em;
          opacity: 0.6;
        }
      }
    }

    .cc-languages textarea {
      min-height: 4rem;
    }

    .cc-rep-weapons {
      .cc-rep-header,
      fieldset,
      .repcontainer .repitem {
        grid-template-columns: 1fr 1fr 1fr 2fr 0.6fr 1.4fr;
      }
    }

    .cc-rep-armor {
      .cc-rep-header,
      fieldset,
      .repcontainer .repitem {
        grid-template-columns: 1.5fr 1fr 2.5fr;
      }
    }
  }

+module.
  // Shared lookup table used by Bonus Damage, Base Armour, Courage, and
  // (in views/_spells.pug) spellcasting Power Rating. Rulebook table:
  // rating <=8 -> 0, 9 -> +1, 10-11 -> +2, 12-13 -> +3, 14-15 -> +4, 16+ -> +5.
  const ccAttributeBonus = (rating) => {
    const r = Number(rating) || 0;
    return r <= 8 ? 0 : Math.ceil((r - 7) / 2);
  };

  const calcAttributeBonusDamage = ({trigger, attributes}) => {
    const attrName = trigger.name.replace(/_bonus_damage$/, '');
    return ccAttributeBonus(attributes[`${attrName}_rating`]);
  };
  k.registerFuncs({calcAttributeBonusDamage});

  const calcBaseArmour = ({attributes}) => ccAttributeBonus(attributes.brawn_rating);
  k.registerFuncs({calcBaseArmour});

  const calcCourage = ({attributes}) => ccAttributeBonus(attributes.will_rating);
  k.registerFuncs({calcCourage});

  const calcTotalArmor = ({attributes}) => {
    const base = ccAttributeBonus(attributes.brawn_rating);
    const armorRows = attributes.repeating_armor || [];
    const armorSum = armorRows.reduce((sum, row) => sum + (Number(row.resistance) || 0), 0);
    return base + armorSum;
  };
  k.registerFuncs({calcTotalArmor});

  // "Add your: Brawn + Resilience, or Will + Resilience (whichever is higher)."
  const calcStressMax = ({attributes}) => {
    const resilience = Number(attributes.resilience_ranks) || 0;
    const brawn = Number(attributes.brawn_rating) || 0;
    const will = Number(attributes.will_rating) || 0;
    return Math.max(brawn, will) + resilience;
  };
  k.registerFuncs({calcStressMax});

  const calcXpAvailable = ({attributes}) => {
    return (Number(attributes.xp_earned) || 0) - (Number(attributes.xp_spent) || 0);
  };
  k.registerFuncs({calcXpAvailable});

  const ccCapitalize = (s) => s.replace(/_/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());

  const ccAttributeQuery = '?{Attribute' +
    '|Agility,@{agility_rating}' +
    '|Brawn,@{brawn_rating}' +
    '|Coordination,@{coordination_rating}' +
    '|Gravitas,@{gravitas_rating}' +
    '|Insight,@{insight_rating}' +
    '|Reason,@{reason_rating}' +
    '|Will,@{will_rating}}';

  // Shared 2d20 roll core, used for Attribute-only rolls, plain Skill
  // rolls (no focus), and Focus rolls. attributeExpr is either a literal
  // rating (attribute-only roll, no choice to make) or the ?{Attribute}
  // query string (skill/focus rolls, since skill-to-attribute pairing
  // isn't fixed by RAW). critMax is the die value at/under which a die is
  // a critical success (this skill's ranks if a focus applies, else 1).
  const runCcRoll = async ({skillLabel, focusLabel, attributeExpr, skillRanks, critMax}) => {
    log(`CC DEBUG: runCcRoll starting, skillLabel=${skillLabel} focusLabel=${focusLabel} skillRanks=${skillRanks}`);

    const difficultyQuery = '?{Difficulty|1}';
    const complicationQuery = '?{Complication range (1-5)|1}';
    const bonusDiceQuery = '?{Additional d20s bought (0-3)|0}';

    // Every field we plan to set via finishRoll must already exist in the
    // original roll string as a [[0]] placeholder - Roll20's finishRoll can
    // only update fields that were part of the initial message, it cannot
    // inject brand new field names. (Confirmed the hard way: character_name/
    // skill/difficulty, which WERE declared upfront, rendered fine; target_
    // number/successes/etc, which were only ever set via finishRoll's second
    // argument, never appeared at all.)
    const rollString = '&{template:ccskill} ' +
      `{{character_name=@{character_name}}} ` +
      `{{skill=${skillLabel}}} ` +
      (focusLabel ? `{{focus=${focusLabel}}} ` : '') +
      `{{attribute_choice=[[0+${attributeExpr}]]}} ` +
      `{{difficulty=[[0+${difficultyQuery}]]}} ` +
      `{{complication_range=[[0+${complicationQuery}]]}} ` +
      `{{roll1=[[(2+${bonusDiceQuery})d20]]}} ` +
      `{{target_number=[[0]]}} ` +
      `{{successes=[[0]]}} ` +
      `{{dice_text=[[0]]}} ` +
      `{{outcome=[[0]]}} ` +
      `{{complications=[[0]]}} ` +
      `{{bonus_momentum=[[0]]}}`;
    log(`CC DEBUG: roll string = ${rollString}`);

    const roll = await startRoll(rollString);
    log(`CC DEBUG: startRoll resolved, raw results = ${JSON.stringify(roll.results)}`);

    try {
      const attributeChoice = Number(roll.results.attribute_choice.result) || 0;
      const difficulty = Number(roll.results.difficulty.result) || 1;
      const complicationRange = Number(roll.results.complication_range.result) || 1;

      // Roll20's documented result shape nests individual dice under
      // rolls[0].results[].v; some sheets also see a flattened .dice
      // array, so try that first if present, then fall back.
      const roll1 = roll.results.roll1;
      const dice = Array.isArray(roll1.dice) ?
        roll1.dice :
        (roll1.rolls && roll1.rolls[0] && roll1.rolls[0].results || []).map((r) => r.v);

      if (!dice.length) {
        finishRoll(roll.rollId, {
          target_number: '?',
          successes: '?',
          dice_text: `error: could not read dice from ${JSON.stringify(roll1)}`,
          outcome: 0,
          complications: 0,
        });
        return;
      }

      const targetNumber = attributeChoice + skillRanks;
      const complicationThreshold = 21 - complicationRange;
      const successCount = dice.filter((d) => d <= targetNumber).length +
        dice.filter((d) => d <= critMax).length;
      const complicationCount = dice.filter((d) => d >= complicationThreshold).length;
      const passed = successCount >= difficulty;

      // outcome is a plain 0/1 flag (rather than separate passed/failed
      // fields) because the Passed/Failed blocks are gated with the
      // rollTotal() helper (an exact-value comparison on the computed
      // override), not a plain {{#field}} truthiness check - which,
      // like {{fieldname}} display, doesn't respect finishRoll overrides
      // on a field that started life as a [[0]] roll expression.
      const overrides = {
        target_number: targetNumber,
        successes: successCount,
        dice_text: dice.join(', '),
        outcome: passed ? 1 : 0,
        bonus_momentum: passed ? Math.max(0, successCount - difficulty) : 0,
        complications: complicationCount,
      };

      log(`CC DEBUG: finishing roll with overrides = ${JSON.stringify(overrides)}`);
      finishRoll(roll.rollId, overrides);
    } catch (err) {
      // Surface failures in chat instead of leaving the template blank
      // with no clue why.
      log(`CC DEBUG: error in runCcRoll: ${err.message}\n${err.stack}`);
      finishRoll(roll.rollId, {
        target_number: '?',
        successes: '?',
        dice_text: `error: ${err.message}`,
        outcome: 0,
        complications: 0,
      });
    }
  };

  // Action-button trigger.name is normalized with dashes (e.g.
  // "academia-focus-finance-roll"), not the underscores used everywhere
  // else on this sheet (attribute/calculation trigger names) - confirmed
  // by inspecting the compiled sheet's own cascade data. Normalize before
  // matching so the regexes below (written against underscore form) work.
  const ccNormalizeName = (name) => name.replace(/-/g, '_');

  // Attribute-only roll (no skill): target number is just the attribute's
  // own rating, crit only on a natural 1 (no focus applies).
  const initiateAttributeRoll = async ({trigger, attributes}) => {
    log(`CC DEBUG: initiateAttributeRoll fired, trigger.name=${trigger.name}`);
    const attr = ccNormalizeName(trigger.name).replace(/_roll$/, '');
    const rating = Number(attributes[`${attr}_rating`]) || 0;
    await runCcRoll({
      skillLabel: ccCapitalize(attr),
      focusLabel: '',
      attributeExpr: String(rating),
      skillRanks: 0,
      critMax: 1,
    });
  };
  k.registerFuncs({initiateAttributeRoll});

  // Plain Skill roll (no specific focus): crit only on a natural 1, per
  // RAW ("if you don't have a focus that applies, each die that rolls a
  // 1 is a critical success").
  const initiateSkillRoll = async ({trigger, attributes}) => {
    log(`CC DEBUG: initiateSkillRoll fired, trigger.name=${trigger.name}`);
    const skill = ccNormalizeName(trigger.name).replace(/_skill_roll$/, '');
    const skillRanks = Number(attributes[`${skill}_ranks`]) || 0;
    await runCcRoll({
      skillLabel: ccCapitalize(skill),
      focusLabel: '',
      attributeExpr: ccAttributeQuery,
      skillRanks,
      critMax: 1,
    });
  };
  k.registerFuncs({initiateSkillRoll});

  // Focus roll: crit on a die <= this skill's ranks, since a
  // focus-specific roller always "has the focus" that applies.
  const initiateFocusRoll = async ({trigger, attributes}) => {
    log(`CC DEBUG: initiateFocusRoll fired, trigger.name=${trigger.name}`);
    const match = ccNormalizeName(trigger.name).match(/^(.+)_focus_(.+)_roll$/);
    if (!match) { return; }
    const [, skill, focusSlug] = match;
    const skillRanks = Number(attributes[`${skill}_ranks`]) || 0;
    await runCcRoll({
      skillLabel: ccCapitalize(skill),
      focusLabel: ccCapitalize(focusSlug),
      attributeExpr: ccAttributeQuery,
      skillRanks,
      critMax: skillRanks,
    });
  };
  k.registerFuncs({initiateFocusRoll});
