+scss.
  .cc-character {
    .cc-footer {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      margin-top: 0.4rem;
      padding-top: 0.2rem;
      border-top: 1px solid var(--cc-rule);
      font-size: 0.65rem;
      color: var(--cc-ink);
      opacity: 0.6;
    }

    // If this never appears in Roll20, the Sheet Style paste is stale -
    // this text lives only in the compiled CSS, not the HTML, so its
    // absence (or an older-looking value than .cc-build-html) means the
    // CSS box wasn't updated to match the last HTML paste.
    .cc-build-css::after {
      content: "CSS build: #{buildVersion}";
    }
    .cc-truths-scars-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 0.3rem;

      .cc-truth,
      .cc-scar {
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--cc-rule);
        color: var(--cc-ink);
        padding: 0.15rem 0.1rem;
      }
    }

    .cc-vitals {
      display: grid;
      grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
      gap: 0.75rem;
      align-items: start;
    }

    .cc-vitals-courage-fortune,
    .cc-vitals-armor {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    // Overrides the generic .cc-field column layout (label above value) to
    // put Max's value on the same line as its label instead, since a
    // standalone "MAX" heading with a boxed number underneath wastes
    // vertical space this field doesn't need - it sits below the already
    // full-width stress track, not beside other stacked fields.
    .cc-stress-max {
      flex-direction: row;
      align-items: baseline;
      gap: 0.4rem;
    }

    // The value=0 anchor radio in both .cc-stress-track and
    // .cc-fortune-track (see the pug comment above .cc-stress-track) never
    // needs to be visible itself - only its checked state matters for the
    // sibling-selector coloring below, same as .cc-stress-max-marker.
    .cc-fill-left-zero {
      display: none;
    }

    .cc-stress-track {
      display: grid;
      grid-template-columns: repeat(10, 1fr);
