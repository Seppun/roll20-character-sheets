//- rolltemplate/_index.pug
//- Chat output for a Focus roll (see initiateFocusRoll in
//- views/_character.pug). Shows the dice, target number, successes,
//- complications (if any), and pass/fail with Momentum generated.
+rolltemplate('ccskill')
  //- All visual styling lives on this inner wrapper, not on the
  //- rolltemplate's own root (.sheet-rolltemplate-ccskill) - see the SCSS
  //- comment below for why.
  .cc-roll-card
    +characterLink
    .cc-roll-header
      span.cc-roll-skill {{skill}}
      +templateConditionalDisplay('focus')
        span.cc-roll-focus ({{focus}})
    .cc-roll-body
      //- Fields we only ever set via finishRoll's overrides (never part of
      //- the initial roll string's dice/query math) must be referenced here
      //- as computed::fieldname - plain {{fieldname}} shows the ORIGINAL
      //- value of the [[0]] placeholder from startRoll, ignoring the
      //- override entirely. Confirmed against the proven pattern in this
      //- repo's Achtung!_Cthulhu_2d20 sheet. difficulty is read from
      //- roll.results but never overridden, so it stays plain.
      //-
      //- A plain {{#field}}/{{#computed::field}} section does NOT respect
      //- finishRoll overrides either (same underlying quirk - the section's
      //- truthiness is checked against the pre-override value), so
      //- conditional display of an overridden field needs the rollTotal()/
      //- rollGreater() helper functions instead, which do an exact
      //- comparison against the computed value (again mirroring
      //- Achtung!_Cthulhu_2d20's own {{#rollTotal() computed::outcome 1}}).
      .cc-roll-row
        span Dice:
        span {{computed::dice_text}}
      .cc-roll-row
        span Target Number:
        span {{computed::target_number}}
      .cc-roll-row
        span Difficulty:
        span {{difficulty}}
      .cc-roll-row
        span Successes:
        span {{computed::successes}}
      +rollGreater({values: 'computed::complications 0'})
        .cc-roll-row.cc-roll-complication
          span Complications:
          span {{computed::complications}}
    +rollTotal({values: 'computed::outcome 1'})
      .cc-roll-outcome.cc-roll-pass
        span Passed - Momentum: {{computed::bonus_momentum}}
    +rollTotal({values: 'computed::outcome 0'})
      .cc-roll-outcome.cc-roll-fail
        span Failed

//- Chat output for a weapon damage roll (see initiateWeaponRoll/
//- runCcDamageRoll in views/_character.pug). Shows the Challenge Dice
//- faces (converted from plain d6s per the rulebook's own fallback table),
//- the total damage, and any Damage Effects that triggered.
+rolltemplate('ccdamage')
  .cc-roll-card
    +characterLink
    .cc-roll-header
      span.cc-roll-skill {{weapon}} Damage
    .cc-roll-body
      .cc-roll-row
        span Challenge Dice:
        span {{computed::dice_text}}
      .cc-roll-row
        span Total Damage:
        span {{computed::total_damage}}
      +rollGreater({values: 'computed::effect_count 0'})
        .cc-roll-row.cc-roll-complication
          span {{computed::effects_summary}}
      .cc-roll-row
        span Weapon Effects:
        span {{effects_list}}

+scss('roll').
  // Roll templates render inside Roll20's chat pane, which sanitizes their
  // CSS through a stricter, older filter than the main sheet - CSS custom
  // properties (var()) are not on its allowlist and get the whole
  // declaration silently dropped. Plain hardcoded colors only in here.
  //
  // Roll20 also auto-prepends "sheet-" to every class used INSIDE a roll
  // template at render time - confirmed by inspecting the live rendered
  // chat DOM, where our own class="cc-roll-header" came out as
  // class="sheet-cc-roll-header", class="character_name" (from the
  // characterLink mixin) came out as class="sheet-character_name", etc.
  // Every selector below other than the rolltemplate's own
  // sheet-rolltemplate-<name> wrapper (which we author with that prefix
  // ourselves - Roll20 doesn't add a second one) and .inlinerollresult
  // (Roll20's own built-in class, never prefixed) needs a matching
  // "sheet-" prefix or it silently never matches anything.
  //
  // Critically: visual styling (background/border/font/padding) does NOT
  // reliably apply when placed directly on .sheet-rolltemplate-ccskill
  // itself - it needs to live on a child wrapper div instead. Confirmed
  // against an old hand-authored prototype of this same sheet that did
  // get roll template styling working, which put all of its visual rules
  // on a nested .sheet-template wrapper rather than the rolltemplate root.
  .sheet-rolltemplate-ccskill .sheet-cc-roll-card {
    font-family: Georgia, serif;
    background: #ece3cd;
    color: #2b2018;
    border: 1px solid #8a1c2b;
    border-radius: 3px;
    padding: 0.4rem 0.6rem;
    min-width: 220px;

    .sheet-character_name {
      margin: 0 0 0.2rem;
      font-size: 1rem;
    }

    // computed::fieldname values render as Roll20's standard inline-roll
    // spans (hoverable, with their own tooltip breakdown), which come
    // with Roll20's default yellow highlight box - strip that back down
    // to plain text so they match the rest of the card. Mirrors
    // Achtung!_Cthulhu_2d20's own .inlinerollresult overrides.
    .inlinerollresult {
      background-color: transparent !important;
      border: 0 transparent !important;
      font-weight: inherit;
      font-size: inherit;
      padding: 0 !important;
      pointer-events: none;
    }

    .sheet-cc-roll-header {
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #8a1c2b;
      margin-bottom: 0.2rem;

      .sheet-cc-roll-focus {
        font-style: italic;
        text-transform: none;
        font-weight: normal;
        margin-left: 0.3rem;
      }
    }

    .sheet-cc-roll-row {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      font-size: 0.9rem;
    }

    .sheet-cc-roll-complication {
      color: #8a1c2b;
      font-weight: bold;
    }

    .sheet-cc-roll-outcome {
      margin-top: 0.3rem;
      font-weight: bold;
      text-align: center;
      padding: 0.15rem;
      border-radius: 2px;
    }

    .sheet-cc-roll-pass {
      background: #2f4a2f;
      color: #e8f0e8;
    }

    .sheet-cc-roll-fail {
      background: #4a1414;
      color: #f0e0e0;
    }
  }

  // Same card styling as .sheet-rolltemplate-ccskill above, duplicated
  // under this template's own root wrapper class - each rolltemplate's
  // root selector is different, so the nested rules have to be repeated
  // per-template even though the inner class names (.cc-roll-card,
  // .cc-roll-row, etc) are shared.
  .sheet-rolltemplate-ccdamage .sheet-cc-roll-card {
    font-family: Georgia, serif;
    background: #ece3cd;
    color: #2b2018;
    border: 1px solid #8a1c2b;
    border-radius: 3px;
    padding: 0.4rem 0.6rem;
    min-width: 220px;

    .sheet-character_name {
      margin: 0 0 0.2rem;
      font-size: 1rem;
    }

    .inlinerollresult {
      background-color: transparent !important;
      border: 0 transparent !important;
      font-weight: inherit;
      font-size: inherit;
      padding: 0 !important;
      pointer-events: none;
    }

    .sheet-cc-roll-header {
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #8a1c2b;
      margin-bottom: 0.2rem;
    }

    .sheet-cc-roll-row {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      font-size: 0.9rem;
    }

    .sheet-cc-roll-complication {
      color: #8a1c2b;
      font-weight: bold;
    }
  }
