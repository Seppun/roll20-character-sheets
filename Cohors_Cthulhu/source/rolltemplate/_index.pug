//- rolltemplate/_index.pug
//- Chat output for a Focus roll (see initiateFocusRoll in
//- views/_character.pug). Shows the dice, target number, successes,
//- complications (if any), and pass/fail with Momentum generated.
+rolltemplate('cc-skill')
  +characterLink
  .cc-roll-header
    span.cc-roll-skill {{skill}}
    +templateConditionalDisplay('focus')
      span.cc-roll-focus ({{focus}})
  .cc-roll-body
    //- Fields we only ever set via finishRoll's overrides (never part of
    //- the initial roll string's dice/query math) must be referenced here
    //- as computed::fieldname, both in {{}} output and in conditional
    //- {{#..}} sections - plain {{fieldname}} shows the ORIGINAL value of
    //- the [[0]] placeholder from startRoll, ignoring the override
    //- entirely. Confirmed against the proven pattern in this repo's
    //- Achtung!_Cthulhu_2d20 sheet, which does exactly this. difficulty is
    //- read from roll.results but never overridden, so it stays plain.
    +templateConditionalDisplay('computed::dice_text')
      .cc-roll-row
        span Dice:
        span {{computed::dice_text}}
    .cc-roll-row
      span Target Number:
      span {{computed::target_number}}
    .cc-roll-row
      span Difficulty:
      span {{difficulty}}
    .cc-roll-row
      span Successes:
      span {{computed::successes}}
    +templateConditionalDisplay('computed::complications')
      .cc-roll-row.cc-roll-complication
        span Complications:
        span {{computed::complications}}
  +templateConditionalDisplay('computed::passed')
    .cc-roll-outcome.cc-roll-pass
      span Passed - Momentum: {{computed::bonus_momentum}}
  +templateConditionalDisplay('computed::failed')
    .cc-roll-outcome.cc-roll-fail
      span Failed

+scss('roll').
  // Roll templates render inside Roll20's chat pane, which sanitizes their
  // CSS through a stricter, older filter than the main sheet - CSS custom
  // properties (var()) are not on its allowlist and get the whole
  // declaration silently dropped. Plain hardcoded colors only in here.
  .sheet-rolltemplate-cc-skill {
    font-family: Georgia, serif;
    background: #ece3cd;
    color: #2b2018;
    border: 1px solid #8a1c2b;
    border-radius: 3px;
    padding: 0.4rem 0.6rem;
    min-width: 220px;

    .cc-roll-header {
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #8a1c2b;
      margin-bottom: 0.2rem;

      .cc-roll-focus {
        font-style: italic;
        text-transform: none;
        font-weight: normal;
        margin-left: 0.3rem;
      }
    }

    .cc-roll-row {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      font-size: 0.9rem;
    }

    .cc-roll-complication {
      color: #8a1c2b;
      font-weight: bold;
    }

    .cc-roll-outcome {
      margin-top: 0.3rem;
      font-weight: bold;
      text-align: center;
      padding: 0.15rem;
      border-radius: 2px;
    }

    .cc-roll-pass {
      background: #2f4a2f;
      color: #e8f0e8;
    }

    .cc-roll-fail {
      background: #4a1414;
      color: #f0e0e0;
    }
  }
