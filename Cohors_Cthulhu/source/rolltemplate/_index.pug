//- rolltemplate/_index.pug
//- Chat output for a 2d20 roll (see initiateAttributeRoll in
//- views/panels/_attributes_panel.pug, initiateSkillRoll/initiateFocusRoll
//- in views/panels/_skills_panel.pug, initiateWeaponRoll in
//- views/panels/_weapons_panel.pug, and initiateSpellRoll in
//- views/_spells.pug). Shows the dice, target number,
//- successes, complications (if any), and pass/fail with Momentum
//- generated. Weapon rolls also set is_weapon, which reveals a Damage
//- section rolled in the very same message - Cohors Cthulhu attack rolls
//- are opposed tests, so damage is rolled unconditionally alongside the
//- attack rather than as a separate, gated follow-up roll. Spell rolls set
//- is_spell instead, revealing a Cost section rolled the same way (the
//- spell's Cost is always paid, pass or fail).
+rolltemplate('ccskill')
  //- All visual styling lives on this inner wrapper, not on the
  //- rolltemplate's own root (.sheet-rolltemplate-ccskill) - see the SCSS
  //- comment below for why.
  .cc-roll-card
    +characterLink
    .cc-roll-header
      span.cc-roll-skill {{skill}}
      +templateConditionalDisplay('focus')
        span.cc-roll-focus ({{focus}})
    .cc-roll-body
      //- Fields set via finishRoll's overrides must be referenced here as
      //- computed::fieldname, and conditional sections on such a field use
      //- the rollGreater()/rollTotal() helpers rather than a plain
      //- {{#field}} check (see lessons_learned.md for why). difficulty is
      //- read from roll.results but never overridden, so it stays plain.
      //- is_weapon is a plain literal set directly in the initial roll
      //- string (never overridden), so a plain {{#is_weapon}} conditional
      //- works fine for it.
      .cc-roll-row
        span Dice:
        span {{computed::dice_text}}
      .cc-roll-row
        span Target Number:
        span {{computed::target_number}}
      .cc-roll-row
        span Difficulty:
        span {{difficulty}}
      .cc-roll-row
        span Successes:
        span {{computed::successes}}
      //- Extraordinary [Attribute] X - already counted in Successes above.
      +rollGreater({values: 'computed::auto_successes 0'})
        .cc-roll-row
          span Extraordinary (auto):
          span +{{computed::auto_successes}}
      +rollGreater({values: 'computed::complications 0'})
        .cc-roll-row.cc-roll-complication
          span Complications:
          span {{computed::complications}}
    +rollTotal({values: 'computed::outcome 1'})
      .cc-roll-outcome.cc-roll-pass
        span Passed - {{pool}}: {{computed::bonus_momentum}}
    +rollTotal({values: 'computed::outcome 0'})
      .cc-roll-outcome.cc-roll-fail
        span Failed
    //- momentum_spent covers every way a roll can cost the party Momentum:
    //- additional d20s bought (all roll types) plus, for spells only,
    //- Extra Momentum declared spent on one of the spell's own listed
    //- Momentum options (e.g. Cyclone of Cernunnos's extra damage, Horn of
    //- Néit's extra Challenge Die) - see runCcRoll in
    //- views/_global_sheetworker.pug, initiateWeaponRoll in
    //- views/panels/_weapons_panel.pug, and initiateSpellRoll in
    //- views/_spells.pug. Hidden when nothing was spent, same as
    //- complications above.
    +rollGreater({values: 'computed::momentum_spent 0'})
      .cc-roll-row
        span {{pool}} Spent:
        span {{computed::momentum_spent}}
    //- Exclusive to initiateFatigueResistRoll
    //- (views/panels/_vitals_panel.pug) - never set by any other roll
    //- type, so always 0/absent and hidden
    //- here otherwise, same "only show it if it triggered" treatment as
    //- Momentum Spent above.
    +rollGreater({values: 'computed::fatigue_removed 0'})
      .cc-roll-row
        span Fatigue Removed:
        span {{computed::fatigue_removed}}
    //- Damage is still rolled unconditionally alongside the attack (see
    //- initiateWeaponRoll in views/panels/_weapons_panel.pug) - only
    //- whether this section DISPLAYS is gated on the attack having passed
    //- (computed::outcome 1), via the same rollTotal()/rollGreater()
    //- helpers already used elsewhere in this template for computed
    //- fields (see lessons_learned.md for why a plain {{#field}} check
    //- doesn't work on a finishRoll override). Rolling both dice sets
    //- unconditionally and only hiding the display keeps this out of the
    //- "conditional rolls in roll templates" trouble documented there,
    //- while still reading as "no damage" on a miss.
    //- {{pool}} is a plain literal set in each roll string (Threat for an
    //- adversary NPC, else Momentum - see ccPoolName in
    //- views/_global_sheetworker.pug), so it displays without computed::.
    +templateConditionalDisplay('mental')
      .cc-roll-row.cc-roll-note
        span Target must be aware of the attacker and within Medium range. Resisted by Courage + Morale.
    +templateConditionalDisplay('is_weapon')
      +rollTotal({values: 'computed::outcome 1'})
        .cc-roll-header.cc-roll-damage-header
          span.cc-roll-skill Damage
        .cc-roll-body
          .cc-roll-row
            span Challenge Dice:
            span.cc-roll-dice-result {{computed::damage_dice_text}}
          .cc-roll-row
            span Total Damage:
            span {{computed::total_damage}}
          //- Only shown when an Effect face actually came up on the dice
          //- (rollGreater gates on effect_count > 0) - a separate always-on
          //- "Weapon Effects: ..." line was removed since it just repeated
          //- the same effect names regardless of whether they triggered.
          +rollGreater({values: 'computed::effect_count 0'})
            .cc-roll-row.cc-roll-complication
              span {{computed::effects_summary}}
    //- Spell Cost is rolled unconditionally alongside the casting test -
    //- RAW pays it "whether or not [the caster] successfully cast it"
    //- (see Casting a Battlefield Spell, page 66) - so it's always shown,
    //- not gated behind a pass/fail check like the spell's own Effect.
    +templateConditionalDisplay('is_spell')
      //- Dabbling spellcasters may pay Threat, per Effect rolled on the
      //- casting pool above, to raise their power rating from 1 to 3 for
      //- this cast (see initiateSpellRoll in views/_spells.pug) - only
      //- ever nonzero when that choice was actually made, same "only show
      //- it if it triggered" treatment as Weapon Effects/Cost Effects.
      +rollGreater({values: 'computed::dabbling_power_threat 0'})
        .cc-roll-row.cc-roll-complication
          span {{computed::dabbling_power_threat}} threat generated as a result of increasing your spellcasting power
      .cc-roll-header.cc-roll-damage-header
        span.cc-roll-skill Cost (paid regardless of outcome)
      .cc-roll-body
        .cc-roll-row
          span Challenge Dice:
          span.cc-roll-dice-result {{computed::cost_dice_text}}
        .cc-roll-row
          span Mental Damage to Caster:
          span {{computed::cost_total}}
        //- Same "only show it if it triggered" treatment as Weapon
        //- Effects above - and Drain is excluded from cost_effects_summary
        //- entirely (see ccParseSpellCost in views/_spells.pug), since
        //- it's inherent to every spell's cost rather than a bonus effect
        //- that only applies when an Effect face is rolled.
        +rollGreater({values: 'computed::cost_effect_count 0'})
          .cc-roll-row.cc-roll-complication
            span {{computed::cost_effects_summary}}
        //- Exclusive to spells in ccSpellCostThreatPerEffect (currently
        //- just Curse of Loki) - see that lookup's comment in
        //- views/_spells.pug. Always 0 for every other spell, same "only
        //- show it if it triggered" treatment as the rows above.
        +rollGreater({values: 'computed::cost_threat_generated 0'})
          .cc-roll-row.cc-roll-complication
            span {{computed::cost_threat_generated}} threat generated from this spell's cost effects

//- A minimal, purpose-built roll template used only to carry the global
//- Momentum pool signal (see ccSendMomentumSignal in
//- views/_global_sheetworker.pug) to a companion Roll20 API script
//- (api-scripts/ccmomentum.js) - never shown to anyone. Deliberately kept
//- separate from ccskill above (rather than piggybacking on its own
//- visible card) so restyling the actual gameplay roll card can never
//- silently break the API script's parsing of this one. The field name
//- (ccmomentumdelta, not just "delta") is distinctive on purpose - see
//- lessons_learned.md for why the API script can't instead detect this
//- roll by its template name.
+rolltemplate('ccmomentumsignal')
  span.cc-momentum-signal-delta {{ccmomentumdelta}}

//- Same purpose as ccmomentumsignal above, but for the GM's Threat pool
//- (see ccSendThreatSignal in views/_global_sheetworker.pug and its
//- companion API script, api-scripts/ccthreat.js) - kept as its own
//- template/hidden roll rather than piggybacking on ccmomentumsignal so
//- this addition can never risk the already-working Momentum signal.
+rolltemplate('ccthreatsignal')
  span.cc-threat-signal-delta {{ccthreatdelta}}

//- Buying additional d20s (see ccSendMomentumSpendSignal in
//- views/_global_sheetworker.pug) is a genuine "spend" that the sheet
//- can't just net into a plain signed delta like ccmomentumsignal above -
//- the sheet has no visibility into the live pool, so it can't know
//- whether that pool can actually cover the cost. This carries the
//- nominal cost as a positive amount instead, and ccmomentum.js decides
//- how much of it the pool can cover, converting any shortfall straight
//- into a Threat signal of its own (reusing ccthreatsignal above
//- unmodified - ccthreat.js's own listener can't tell a script-generated
//- signal from a sheet-sent one). Kept as its own template/field name
//- (ccmomentumspend, not reusing ccmomentumdelta) for the same reason
//- ccthreatsignal stays separate from ccmomentumsignal - this addition
//- can never risk the already-working plain delta signal.
+rolltemplate('ccmomentumspendsignal')
  span.cc-momentum-spend-signal-amount {{ccmomentumspend}}

+scss('roll').
  /* Plain hardcoded colors only in this block - roll-template CSS can't
     use custom properties (var()), unlike the main sheet stylesheet (see
     lessons_learned.md). Every class used inside a rolltemplate's markup
     needs a matching "sheet-" prefix here (Roll20 adds it at render time
     to everything except the rolltemplate's own sheet-rolltemplate-<name>
     wrapper and the built-in .inlinerollresult), and visual styling lives
     on the inner .sheet-cc-roll-card wrapper, not the
     .sheet-rolltemplate-ccskill root itself - see lessons_learned.md for
     both. */
  .sheet-rolltemplate-ccskill .sheet-cc-roll-card {
    font-family: Georgia, serif;
    background: #ece3cd;
    color: #2b2018;
    border: 1px solid #8a1c2b;
    border-radius: 3px;
    padding: 0.4rem 0.6rem;
    min-width: 220px;

    .sheet-character_name {
      margin: 0 0 0.2rem;
      font-size: 1rem;
    }

    /* computed::fieldname values render as Roll20's standard inline-roll
       spans (hoverable, with their own tooltip breakdown), which come
       with Roll20's default yellow highlight box - strip that back down
       to plain text so they match the rest of the card. Mirrors
       Achtung!_Cthulhu_2d20's own .inlinerollresult overrides. */
    .inlinerollresult {
      background-color: transparent !important;
      border: 0 transparent !important;
      font-weight: inherit;
      font-size: inherit;
      padding: 0 !important;
      pointer-events: none;
    }

    .sheet-cc-roll-header {
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #8a1c2b;
      margin-bottom: 0.2rem;

      .sheet-cc-roll-focus {
        font-style: italic;
        text-transform: none;
        font-weight: normal;
        margin-left: 0.3rem;
      }
    }

    .sheet-cc-roll-damage-header {
      margin-top: 0.3rem;
      padding-top: 0.3rem;
      border-top: 1px dashed #8a1c2b;
    }

    .sheet-cc-roll-row {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      font-size: 0.9rem;
    }

    /* Challenge Dice results (the †/‡/–/☠ symbols) are the main thing a
       player scans for after a damage/cost roll, so they read larger than
       the rest of the row text around them. */
    .sheet-cc-roll-dice-result {
      font-size: 1.4rem;
    }

    .sheet-cc-roll-note {
      font-size: 0.8rem;
      font-style: italic;
    }

    .sheet-cc-roll-complication {
      color: #8a1c2b;
      font-weight: bold;
    }

    .sheet-cc-roll-outcome {
      margin-top: 0.3rem;
      font-weight: bold;
      text-align: center;
      padding: 0.15rem;
      border-radius: 2px;
    }

    .sheet-cc-roll-pass {
      background: #2f4a2f;
      color: #e8f0e8;
    }

    .sheet-cc-roll-fail {
      background: #4a1414;
      color: #f0e0e0;
    }
  }

  /* The Momentum and Threat pool signal cards (see the pug comments above
     +rolltemplate('ccmomentumsignal')/+rolltemplate('ccthreatsignal')) are
     never meant to be seen - only their rendered HTML (still present in
     the chat message payload the API scripts read, regardless of
     display:none) matters. */
  .sheet-rolltemplate-ccmomentumsignal,
  .sheet-rolltemplate-ccthreatsignal,
  .sheet-rolltemplate-ccmomentumspendsignal {
    display: none;
  }
