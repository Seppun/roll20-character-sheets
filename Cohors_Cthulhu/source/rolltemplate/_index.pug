//- rolltemplate/_index.pug
//- Chat output for a 2d20 roll (see initiateAttributeRoll/initiateSkillRoll/
//- initiateFocusRoll/initiateWeaponRoll in views/_character.pug, and
//- initiateSpellRoll in views/_spells.pug). Shows the dice, target number,
//- successes, complications (if any), and pass/fail with Momentum
//- generated. Weapon rolls also set is_weapon, which reveals a Damage
//- section rolled in the very same message - Cohors Cthulhu attack rolls
//- are opposed tests, so damage is rolled unconditionally alongside the
//- attack rather than as a separate, gated follow-up roll. Spell rolls set
//- is_spell instead, revealing a Cost section rolled the same way (the
//- spell's Cost is always paid, pass or fail).
+rolltemplate('ccskill')
  //- All visual styling lives on this inner wrapper, not on the
  //- rolltemplate's own root (.sheet-rolltemplate-ccskill) - see the SCSS
  //- comment below for why.
  .cc-roll-card
    +characterLink
    .cc-roll-header
      span.cc-roll-skill {{skill}}
      +templateConditionalDisplay('focus')
        span.cc-roll-focus ({{focus}})
    .cc-roll-body
      //- Fields we only ever set via finishRoll's overrides (never part of
      //- the initial roll string's dice/query math) must be referenced here
      //- as computed::fieldname - plain {{fieldname}} shows the ORIGINAL
      //- value of the [[0]] placeholder from startRoll, ignoring the
      //- override entirely. Confirmed against the proven pattern in this
      //- repo's Achtung!_Cthulhu_2d20 sheet. difficulty is read from
      //- roll.results but never overridden, so it stays plain.
      //-
      //- A plain {{#field}}/{{#computed::field}} section does NOT respect
      //- finishRoll overrides either (same underlying quirk - the section's
      //- truthiness is checked against the pre-override value), so
      //- conditional display of an overridden field needs the rollTotal()/
      //- rollGreater() helper functions instead, which do an exact
      //- comparison against the computed value (again mirroring
      //- Achtung!_Cthulhu_2d20's own {{#rollTotal() computed::outcome 1}}).
      //- is_weapon is different: it's a plain literal set directly in the
      //- initial roll string (never overridden), so a plain {{#is_weapon}}
      //- conditional works fine for it.
      .cc-roll-row
        span Dice:
        span {{computed::dice_text}}
      .cc-roll-row
        span Target Number:
        span {{computed::target_number}}
      .cc-roll-row
        span Difficulty:
        span {{difficulty}}
      .cc-roll-row
        span Successes:
        span {{computed::successes}}
      +rollGreater({values: 'computed::complications 0'})
        .cc-roll-row.cc-roll-complication
          span Complications:
          span {{computed::complications}}
    +rollTotal({values: 'computed::outcome 1'})
      .cc-roll-outcome.cc-roll-pass
        span Passed - Momentum: {{computed::bonus_momentum}}
    +rollTotal({values: 'computed::outcome 0'})
      .cc-roll-outcome.cc-roll-fail
        span Failed
    //- Only spell rolls ever set extra_momentum (see initiateSpellRoll in
    //- views/_spells.pug) - it's the Momentum a caster declares spending
    //- on one of their spell's own listed Momentum options (e.g. Cyclone
    //- of Cernunnos's extra damage, Horn of Néit's extra Challenge Die).
    //- For weapon/plain skill rolls the field is never set, so this stays
    //- hidden the same way is_weapon/is_spell themselves do.
    +rollGreater({values: 'computed::extra_momentum 0'})
      .cc-roll-row
        span {{computed::extra_momentum}} extra momentum spent
    +templateConditionalDisplay('is_weapon')
      .cc-roll-header.cc-roll-damage-header
        span.cc-roll-skill Damage
      .cc-roll-body
        .cc-roll-row
          span Challenge Dice:
          span.cc-roll-dice-result {{computed::damage_dice_text}}
        .cc-roll-row
          span Total Damage:
          span {{computed::total_damage}}
        //- Only shown when an Effect face actually came up on the dice
        //- (rollGreater gates on effect_count > 0) - a separate always-on
        //- "Weapon Effects: ..." line was removed since it just repeated
        //- the same effect names regardless of whether they triggered.
        +rollGreater({values: 'computed::effect_count 0'})
          .cc-roll-row.cc-roll-complication
            span {{computed::effects_summary}}
    //- Spell Cost is rolled unconditionally alongside the casting test -
    //- RAW pays it "whether or not [the caster] successfully cast it"
    //- (see Casting a Battlefield Spell, page 66) - so it's always shown,
    //- not gated behind a pass/fail check like the spell's own Effect.
    +templateConditionalDisplay('is_spell')
      .cc-roll-header.cc-roll-damage-header
        span.cc-roll-skill Cost (paid regardless of outcome)
      .cc-roll-body
        .cc-roll-row
          span Challenge Dice:
          span.cc-roll-dice-result {{computed::cost_dice_text}}
        .cc-roll-row
          span Mental Damage to Caster:
          span {{computed::cost_total}}
        //- Same "only show it if it triggered" treatment as Weapon
        //- Effects above - and Drain is excluded from cost_effects_summary
        //- entirely (see ccParseSpellCost in views/_spells.pug), since
        //- it's inherent to every spell's cost rather than a bonus effect
        //- that only applies when an Effect face is rolled.
        +rollGreater({values: 'computed::cost_effect_count 0'})
          .cc-roll-row.cc-roll-complication
            span {{computed::cost_effects_summary}}

//- A minimal, purpose-built roll template used only to carry the global
//- Momentum pool signal (see ccSendMomentumSignal in views/_character.pug)
//- to a companion Roll20 API script (api-scripts/ccmomentum.js) - never
//- shown to anyone. Deliberately kept separate from ccskill above (rather
//- than piggybacking on its own visible card) so restyling the actual
//- gameplay roll card - already done several times - can never silently
//- break the API script's parsing of this one. Sheet workers have no
//- sendChat() of their own (confirmed live: it throws "sendChat is not
//- defined"), so this rides startRoll/a real dice roll instead, which is
//- the only way sheet-worker code can put anything into chat at all.
//-
//- Confirmed live: Roll20 strips the &{template:X} reference itself out
//- of msg.content before the API ever sees it - true for EVERY roll, not
//- just this one (a normal, finished ccskill weapon roll's msg.content
//- has no "template:ccskill" in it either) - only the {{field=value}}
//- pairs survive. So the API script can't detect "is this our signal" by
//- template name at all; it looks for this field's own distinctive name
//- instead (ccmomentumdelta, not just "delta", to keep it unlikely to
//- collide with an unrelated field from anything else in the game).
+rolltemplate('ccmomentumsignal')
  span.cc-momentum-signal-delta {{ccmomentumdelta}}

+scss('roll').
  // Roll templates render inside Roll20's chat pane, which sanitizes their
  // CSS through a stricter, older filter than the main sheet - CSS custom
  // properties (var()) are not on its allowlist and get the whole
  // declaration silently dropped. Plain hardcoded colors only in here.
  //
  // Roll20 also auto-prepends "sheet-" to every class used INSIDE a roll
  // template at render time - confirmed by inspecting the live rendered
  // chat DOM, where our own class="cc-roll-header" came out as
  // class="sheet-cc-roll-header", class="character_name" (from the
  // characterLink mixin) came out as class="sheet-character_name", etc.
  // Every selector below other than the rolltemplate's own
  // sheet-rolltemplate-<name> wrapper (which we author with that prefix
  // ourselves - Roll20 doesn't add a second one) and .inlinerollresult
  // (Roll20's own built-in class, never prefixed) needs a matching
  // "sheet-" prefix or it silently never matches anything.
  //
  // Critically: visual styling (background/border/font/padding) does NOT
  // reliably apply when placed directly on .sheet-rolltemplate-ccskill
  // itself - it needs to live on a child wrapper div instead. Confirmed
  // against an old hand-authored prototype of this same sheet that did
  // get roll template styling working, which put all of its visual rules
  // on a nested .sheet-template wrapper rather than the rolltemplate root.
  .sheet-rolltemplate-ccskill .sheet-cc-roll-card {
    font-family: Georgia, serif;
    background: #ece3cd;
    color: #2b2018;
    border: 1px solid #8a1c2b;
    border-radius: 3px;
    padding: 0.4rem 0.6rem;
    min-width: 220px;

    .sheet-character_name {
      margin: 0 0 0.2rem;
      font-size: 1rem;
    }

    // computed::fieldname values render as Roll20's standard inline-roll
    // spans (hoverable, with their own tooltip breakdown), which come
    // with Roll20's default yellow highlight box - strip that back down
    // to plain text so they match the rest of the card. Mirrors
    // Achtung!_Cthulhu_2d20's own .inlinerollresult overrides.
    .inlinerollresult {
      background-color: transparent !important;
      border: 0 transparent !important;
      font-weight: inherit;
      font-size: inherit;
      padding: 0 !important;
      pointer-events: none;
    }

    .sheet-cc-roll-header {
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: #8a1c2b;
      margin-bottom: 0.2rem;

      .sheet-cc-roll-focus {
        font-style: italic;
        text-transform: none;
        font-weight: normal;
        margin-left: 0.3rem;
      }
    }

    .sheet-cc-roll-damage-header {
      margin-top: 0.3rem;
      padding-top: 0.3rem;
      border-top: 1px dashed #8a1c2b;
    }

    .sheet-cc-roll-row {
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
      font-size: 0.9rem;
    }

    // Challenge Dice results (the †/‡/–/☠ symbols) are the main thing a
    // player scans for after a damage/cost roll, so they read larger than
    // the rest of the row text around them.
    .sheet-cc-roll-dice-result {
      font-size: 1.4rem;
    }

    .sheet-cc-roll-complication {
      color: #8a1c2b;
      font-weight: bold;
    }

    .sheet-cc-roll-outcome {
      margin-top: 0.3rem;
      font-weight: bold;
      text-align: center;
      padding: 0.15rem;
      border-radius: 2px;
    }

    .sheet-cc-roll-pass {
      background: #2f4a2f;
      color: #e8f0e8;
    }

    .sheet-cc-roll-fail {
      background: #4a1414;
      color: #f0e0e0;
    }
  }

  // The Momentum pool signal card (see the pug comment above
  // +rolltemplate('ccmomentumsignal')) is never meant to be seen - only
  // its rendered HTML (still present in the chat message payload the API
  // script reads, regardless of display:none) matters.
  .sheet-rolltemplate-ccmomentumsignal {
    display: none;
  }
